---
// "Explora por área": mapa rápido del catálogo en la home.
//
// Las áreas NO están escritas a mano: salen de las categorías raíz de
// WooCommerce, con el mismo criterio que el menú y el footer (ver areasDeTienda
// en @/lib/categorias). Si el cliente crea, renombra o vacía un área, esta
// sección se actualiza sola en el próximo build.
//
// La foto de cada tarjeta es la IMAGEN DE LA CATEGORÍA en WordPress
// (Productos → Categorías → editar el área → "Imagen"). Se elige una imagen
// representativa por área y aparece sola en el próximo build, sin tocar código.
// Si un área no tiene imagen cargada, la tarjeta cae a un fondo de rayas con el
// icono del área, así que nada se rompe mientras se suben las fotos.
import { getAllWooCategories, getCatalogoCompleto } from '@/lib/api';
import type { WooCategory } from '@/lib/api';
import { areasDeTienda, conteosDeRama } from '@/lib/categorias';
import type { Area } from '@/lib/categorias';

// La API de Woo ya entrega `image` en cada categoría; se tipa aquí para no
// depender de que WooCategory (en @/lib/api) lo declare.
type CategoriaConImagen = WooCategory & { image?: { src: string; alt: string } | null };

type Tarjeta = Area & { foto?: { src: string; alt: string } };

let areas: Tarjeta[] = [];
try {
    const [categorias, productos] = await Promise.all([
        getAllWooCategories(),
        getCatalogoCompleto(),
    ]);
    const porSlug = new Map<string, CategoriaConImagen>(categorias.map((c) => [c.slug, c]));

    areas = areasDeTienda(categorias, conteosDeRama(categorias, productos)).map((area) => {
        const imagen = porSlug.get(area.slug)?.image;
        return { ...area, foto: imagen?.src ? { src: imagen.src, alt: imagen.alt || '' } : undefined };
    });
} catch (error) {
    console.error('[categorias] No se pudieron cargar las áreas:', error);
}

// Icono de respaldo (solo si el área no tiene imagen en WP), buscado por slug.
// Un slug nuevo cae en el icono genérico y la sección no se rompe.
const ICONOS: Record<string, string> = {
    'jardineria': 'M12 21c0-5 2-9 7-11-1 5-3 8-7 9M12 21c0-6-2-10-7-12 1 6 3 9 7 11M12 21v-6',
    'area-forestal': 'M12 3 6.5 12h3L5 19h14l-4.5-7h3L12 3ZM12 19v3',
    'huertos-y-agricolas': 'M4 20c0-5 3-8 8-8s8 3 8 8M12 12V6M12 6c0-1.7 1.3-3 3-3M12 6c0-1.7-1.3-3-3-3',
    'maquinarias': 'M4 17V9a2 2 0 0 1 2-2h7l3 4h2a2 2 0 0 1 2 2v4M4 17h16M7.5 17a1.5 1.5 0 1 0 3 0 1.5 1.5 0 1 0-3 0M14.5 17a1.5 1.5 0 1 0 3 0 1.5 1.5 0 1 0-3 0',
    'herramientas': 'm14.5 5.5 4 4-9 9-4-4 9-9ZM5.5 14.5 3 21l6.5-2.5M16 3l5 5',
    'repuestos': 'M12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7ZM12 3v2.5M12 18.5V21M3 12h2.5M18.5 12H21M5.6 5.6l1.8 1.8M16.6 16.6l1.8 1.8M5.6 18.4l1.8-1.8M16.6 7.4l1.8-1.8',
};

const ICONO_GENERICO = 'M4 7h16M4 12h16M4 17h10';
---

{areas.length > 0 && (
    <section class="mx-auto max-w-6xl px-6 py-14 md:py-16">
        <div class="mb-7 flex items-end justify-between gap-4" data-anim>
            <div>
                <p class="font-mono text-[11px] tracking-[0.16em] text-isotipo">EXPLORA POR ÁREA</p>
                <h2 class="mt-1.5 font-display text-3xl font-semibold text-primary">
                    Todo el catálogo, por rubro
                </h2>
            </div>
        </div>

        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3" data-anim-stagger="0.06">
            {areas.map((area) => (
                <a
                    href={`/tienda/${area.slug}`}
                    class="group relative flex h-56 items-end overflow-hidden rounded-2xl bg-[repeating-linear-gradient(135deg,#d9e2d3_0_14px,#e3ebdd_14px_28px)] transition-transform duration-300 ease-out hover:-translate-y-1.5"
                >
                    {area.foto ? (
                        <img
                            src={area.foto.src}
                            alt={area.foto.alt}
                            loading="lazy"
                            decoding="async"
                            class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                        />
                    ) : (
                        <svg class="absolute top-5 right-5 size-12 text-isotipo/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d={ICONOS[area.slug] ?? ICONO_GENERICO} />
                        </svg>
                    )}

                    {/* Velo que se tiñe de verde al pasar el mouse. */}
                    <div class="absolute inset-0 bg-green-950/0 transition-colors duration-300 group-hover:bg-green-950/25"></div>

                    <div class="relative flex w-full items-end justify-between gap-3 bg-linear-to-t from-green-900/95 via-green-900/60 to-transparent p-5 pt-12">
                        <div class="min-w-0">
                            <p class="font-mono text-xs text-green-200">
                                {area.count} {area.count === 1 ? 'producto' : 'productos'}
                            </p>
                            <h3 class="mt-0.5 font-display text-xl leading-snug font-semibold text-white">
                                {area.name}
                            </h3>
                        </div>
                        <span class="shrink-0 text-white transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
                    </div>
                </a>
            ))}
        </div>
    </section>
)}