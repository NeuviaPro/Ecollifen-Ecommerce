---
import Layout from '@/layouts/Layout.astro';
import ProductCard from '@/components/product/ProductCard.astro';
import SelectorVariantes from '@/components/product/SelectorVariantes.astro';
import { getCatalogoCompleto, getAllWooCategories, getWooProductVariations } from '@/lib/api';
import type { WooProduct, WooVariation } from '@/lib/api';
import { asesoriaHref, hayWhatsApp } from '@/lib/contacto';
import { sanearContenidoWP } from '@/lib/contenido-wp';
import {
    formatoMonedaCLP,
    calcularDescuento,
    encontrarVarianteInicial,
} from '@/lib/variantes';

// Una página estática por producto de WooCommerce.
export async function getStaticPaths() {
    // La constante va DENTRO: Astro extrae getStaticPaths a su propio módulo y
    // lo ejecuta antes que el componente, así que no ve nada del frontmatter.
    const RELACIONADOS = 4;

    const [products, categorias] = await Promise.all([
        getCatalogoCompleto(),
        getAllWooCategories(),
    ]);

    // Índices calculados UNA sola vez y reutilizados por las ~90 fichas. Armar
    // los relacionados recorriendo el catálogo entero dentro de cada página
    // sería el mismo trabajo repetido noventa veces.
    const porCategoria = new Map<number, WooProduct[]>();
    for (const p of products) {
        for (const c of p.categories ?? []) {
            const lista = porCategoria.get(c.id);
            if (lista) lista.push(p);
            else porCategoria.set(c.id, [p]);
        }
    }
    const padreDe = new Map(categorias.map((c) => [c.id, c.parent]));

    // "Podrían interesarte" = productos de las MISMAS categorías. Si la
    // categoría es muy chica, se completa con los de su categoría padre, que
    // siguen siendo del mismo rubro. No se rellena nunca con productos al azar:
    // sugerir cualquier cosa bajo ese título es mentirle al cliente.
    const relacionadosDe = (producto: WooProduct): WooProduct[] => {
        const propias = (producto.categories ?? []).map((c) => c.id);
        const padres = propias.map((id) => padreDe.get(id) ?? 0).filter((id) => id > 0);

        const vistos = new Set<number>([producto.id]);
        const salida: WooProduct[] = [];

        for (const catId of [...propias, ...padres]) {
            for (const candidato of porCategoria.get(catId) ?? []) {
                if (vistos.has(candidato.id)) continue;
                vistos.add(candidato.id);
                salida.push(candidato);
            }
        }

        // Lo que se puede comprar hoy, primero.
        salida.sort((a, b) =>
            Number(b.stock_status === 'instock') - Number(a.stock_status === 'instock'));

        return salida.slice(0, RELACIONADOS);
    };

    // Las descripciones vienen de WordPress y arrastran enlaces a archivos que
    // no existen (ver @/lib/contenido-wp). Se limpian ACÁ, una sola vez por
    // producto, y no dentro del componente: las URLs se comprueban por red.
    const conEnlacesRotos: { nombre: string, urls: string[] }[] = [];

    const rutas = await Promise.all(products.map(async (product) => {
        const [descripcion, resumen] = await Promise.all([
            sanearContenidoWP(product.description || ''),
            sanearContenidoWP(product.short_description || ''),
        ]);

        const urls = [...new Set([...descripcion.rotos, ...resumen.rotos])];
        if (urls.length > 0) conEnlacesRotos.push({ nombre: product.name, urls });

        // Si es producto variable, cargamos sus variantes de manera memoizada
        let variantes: WooVariation[] = [];
        if (product.type === 'variable' && product.variations && product.variations.length > 0) {
            try {
                variantes = await getWooProductVariations(product.id);
            } catch (err) {
                console.error(`[producto ${product.id}] No se pudieron cargar variantes:`, err);
            }
        }

        return {
            params: { id: String(product.id) },
            props: {
                product,
                variantes,
                relacionados: relacionadosDe(product),
                descripcionHTML: descripcion.html,
                resumenHTML: resumen.html,
            },
        };
    }));

    // Se avisa en cada build: lo de arriba esconde el síntoma, pero el arreglo
    // de verdad es corregir esas descripciones en WooCommerce.
    if (conEnlacesRotos.length > 0) {
        const total = new Set(conEnlacesRotos.flatMap((p) => p.urls)).size;
        console.warn(
            `[producto] ${conEnlacesRotos.length} producto(s) con ${total} enlace(s) rotos a wp-content/uploads. ` +
            `Se quitaron del HTML publicado; conviene limpiarlos en WooCommerce:`
        );
        for (const { nombre, urls } of conEnlacesRotos) {
            console.warn(`  · ${nombre} (${urls.length})`);
        }
    }

    return rutas;
}

const { product, variantes = [], relacionados, descripcionHTML, resumenHTML } = Astro.props as {
    product: WooProduct;
    variantes?: WooVariation[];
    relacionados: WooProduct[];
    descripcionHTML: string;
    resumenHTML: string;
};

const esVariable = product.type === 'variable' && variantes.length > 0;
const varianteInicial = esVariable
    ? encontrarVarianteInicial(variantes, product.default_attributes)
    : undefined;

const estados: Record<string, { label: string, chip: string }> = {
    instock:     { label: 'En stock',    chip: 'border-green-200 bg-green-50 text-green-700' },
    onbackorder: { label: 'Bajo pedido', chip: 'border-gold-200 bg-gold-50 text-gold-700' },
    outofstock:  { label: 'Sin stock',   chip: 'border-border bg-surface-alt text-muted' },
};

// Si hay variante inicial, preseleccionamos sus datos en el HTML servido (SSG)
const precioActual = Number(varianteInicial?.price || product.price);
const precioNormal = Number(varianteInicial?.regular_price || product.regular_price || 0);
const { hayDescuento, porcentaje } = calcularDescuento(precioActual, precioNormal);

const estadoKey = varianteInicial?.stock_status || product.stock_status;
const estado = estados[estadoKey] ?? estados.outofstock;
const enStock = estadoKey === 'instock';

const skuActual = varianteInicial?.sku || product.sku;
const categoria = product.categories?.[0];

// Galería de imágenes inicial: si la variante inicial tiene fotos propias o galería, las usamos;
// de lo contrario, usamos las imágenes generales del producto.
const imagenesIniciales = (esVariable && varianteInicial?.images && varianteInicial.images.length > 0)
    ? varianteInicial.images
    : (product.images || []);

const mainImage = imagenesIniciales[0] || product.images?.[0];
const initialAddToCartId = varianteInicial?.id || product.id;

// Ficha técnica: se arma con los atributos visibles del producto en Woo, más
// peso y dimensiones si están cargados. Hoy la mayoría no tiene atributos, así
// que solo se muestran las filas que existen de verdad — nada de campos con
// "—" de relleno para simular una ficha completa.
const especificaciones: { k: string, v: string }[] = [
    ...(product.attributes ?? [])
        .filter((a) => a.visible && a.options?.length)
        .map((a) => ({ k: a.name, v: a.options.join(', ') })),
];

const pesoActual = varianteInicial?.weight || product.weight;
if (pesoActual) {
    especificaciones.push({ k: 'Peso', v: `${pesoActual} kg` });
}

const d = (varianteInicial?.dimensions?.length && varianteInicial.dimensions) || product.dimensions;
if (d?.length && d?.width && d?.height) {
    especificaciones.push({ k: 'Dimensiones', v: `${d.length} × ${d.width} × ${d.height} cm` });
}

if (skuActual) especificaciones.push({ k: 'SKU', v: skuActual });
if (categoria) especificaciones.push({ k: 'Categoría', v: categoria.name });

// Respaldos que ya son promesa declarada del negocio en todo el sitio (la tira
// del hero y la barra superior). Se repiten aquí porque es el momento exacto en
// que alguien decide comprar. NO se inventan plazos, costos ni garantías: eso
// todavía no está definido con el cliente.
const respaldos = [
    { titulo: 'Asesoría antes de comprar', detalle: 'Te ayudamos a elegir la solución correcta.', icono: 'chat' },
    { titulo: 'Servicio técnico y postventa', detalle: 'Lo que vendemos, lo seguimos atendiendo.', icono: 'gear' },
    { titulo: 'Despacho a todo Chile', detalle: 'Coordinamos el envío según tu ubicación.', icono: 'truck' },
];

// Consulta con el producto ya escrito: quien pregunta no tiene que explicar
// cuál es, y quien responde sabe de entrada de qué se trata.
const nombreParaConsulta = varianteInicial?.attributes?.length
    ? `${product.name} - ${varianteInicial.attributes.map((a) => a.option).filter(Boolean).join(', ')}`
    : product.name;

const urlProducto = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;
const consultaHref = asesoriaHref(
    `Hola, quiero asesoría por el producto "${nombreParaConsulta}"${skuActual ? ` (SKU ${skuActual})` : ''}: ${urlProducto}`,
);

// Estilos base para el HTML que viene de WordPress (sin plugin de tipografía).
const contenidoWP = "leading-relaxed [&_p]:mb-3 [&_ul]:my-3 [&_ul]:list-disc [&_ul]:pl-5 [&_li]:mb-1 [&_strong]:font-semibold [&_a]:text-isotipo [&_a]:underline";

// Open Graph: para que un link de producto compartido por WhatsApp muestre su
// propia foto, nombre y precio en vez de la tarjeta genérica del sitio.
const descripcionOG = (resumenHTML || descripcionHTML || '')
    .replace(/<[^>]*>/g, ' ')
    .replace(/&[a-z]+;|&#\d+;/gi, ' ')
    .replace(/\s+/g, ' ')
    .trim()
    .slice(0, 160) || `${formatoMonedaCLP(precioActual)} · ${estado.label}. Cotiza con asesoría técnica en Ecollifén.`;
---

<Layout title={product.name} description={descripcionOG} image={mainImage?.src} type="product">
    <div class="ficha-fondo">
        <div class="mx-auto max-w-6xl px-6 py-10">
            <nav class="font-mono text-xs text-muted">
                <a href="/" class="transition-colors hover:text-primary">Inicio</a> /
                <a href="/tienda" class="transition-colors hover:text-primary">Tienda</a>
                {categoria && (
                    <Fragment> / <a href={`/tienda/${categoria.slug}`} class="transition-colors hover:text-primary">{categoria.name}</a></Fragment>
                )}
                / <span class="text-foreground">{product.name}</span>
            </nav>

            <div class="mt-6 grid gap-10 lg:grid-cols-2 lg:gap-14">
                {/* ---------- Galería ---------- */}
                <div data-anim="fade-right">
                    {/* Mismo criterio que las tarjetas: fondo blanco para que las
                        fotos de catálogo (90% con fondo blanco) no se vean pegadas. */}
                    <div class="relative aspect-square overflow-hidden rounded-2xl border border-border bg-white p-6">
                        <span
                            data-descuento-badge
                            hidden={!hayDescuento}
                            class="absolute top-4 left-4 z-10 rounded-md bg-cta px-2.5 py-1.5 font-mono text-[11px] font-semibold text-cta-contrast"
                        >
                            −{porcentaje}%
                        </span>
                        {mainImage ? (
                            <img
                                data-main-image
                                src={mainImage.src}
                                alt={mainImage.alt || product.name}
                                class="h-full w-full object-contain"
                            />
                        ) : (
                            <div class="flex h-full items-center justify-center text-muted">Sin imagen</div>
                        )}
                    </div>

                    {/* Galería de miniaturas (adaptable a las imágenes de la variante) */}
                    <div
                        data-galeria-miniaturas
                        data-fotos-producto={JSON.stringify(product.images || [])}
                        class="mt-3 flex flex-wrap gap-3"
                        hidden={imagenesIniciales.length <= 1}
                    >
                        {imagenesIniciales.map((img, i) => (
                            <button
                                type="button"
                                data-thumb={img.src}
                                aria-label={`Ver imagen ${i + 1} de ${imagenesIniciales.length}`}
                                class:list={[
                                    "size-18 cursor-pointer overflow-hidden rounded-lg border-[1.5px] bg-white p-1.5 transition-colors",
                                    img.src === mainImage?.src ? "border-isotipo" : "border-border hover:border-green-300",
                                ]}
                            >
                                <img src={img.src} alt="" class="h-full w-full object-contain" loading="lazy" />
                            </button>
                        ))}
                    </div>
                </div>

                {/* ---------- Panel de compra ----------
                    Los data-* de este contenedor los usa PreciosEnVivo para
                    refrescar precio y stock contra la Store API al cargar.
                    Si es variable, omitimos data-price para evitar que sobreescriba
                    el precio específico de la variante seleccionada. */}
                <div
                    data-panel-compra
                    data-id={product.id}
                    data-price={esVariable ? undefined : product.price}
                    data-stock={esVariable ? undefined : product.stock_status}
                    data-anim="fade-left"
                    data-anim-delay="0.1"
                >
                    {categoria && (
                        <a href={`/tienda/${categoria.slug}`} class="font-mono text-xs tracking-wide text-isotipo uppercase transition-colors hover:text-primary">
                            {categoria.name}
                        </a>
                    )}
                    <h1 class="mt-2 font-display text-3xl leading-tight font-semibold text-balance text-primary md:text-4xl">
                        {product.name}
                    </h1>

                    <div class="mt-4 flex flex-wrap items-center gap-3">
                        <span
                            data-estado
                            class:list={["inline-flex items-center gap-1.5 rounded-full border px-3 py-1 font-mono text-[11px] font-medium", estado.chip]}
                        >&#9679; {estado.label}</span>
                        <span
                            data-sku
                            hidden={!skuActual}
                            class="font-mono text-[11px] text-muted"
                        >SKU · {skuActual}</span>
                    </div>

                    <div class="mt-6 flex flex-wrap items-baseline gap-3">
                        <span data-precio class="text-4xl leading-none font-bold tracking-tight text-green-700 tabular-nums">
                            {formatoMonedaCLP(precioActual)}
                        </span>
                        <span
                            data-precio-normal
                            hidden={!hayDescuento}
                            class="text-lg text-muted line-through tabular-nums"
                        >
                            {formatoMonedaCLP(precioNormal)}
                        </span>
                    </div>

                    {resumenHTML && (
                        <div class:list={["mt-5 text-muted", contenidoWP]} set:html={resumenHTML} />
                    )}

                    {/* Selector adaptativo de variantes si el producto es variable */}
                    {esVariable && (
                        <div class="mt-6">
                            <SelectorVariantes
                                producto={product}
                                variantes={variantes}
                                varianteInicial={varianteInicial}
                            />
                        </div>
                    )}

                    {/* Cantidad + compra. El contenedor data-compra es lo que lee
                        el handler global del carrito para saber cuántas unidades.
                        Ambos llevan data-btn-agregar porque PreciosEnVivo los
                        oculta juntos si el stock cambió desde el último build. */}
                    <div data-compra class="mt-7 flex flex-wrap items-stretch gap-3">
                        <div class="flex items-center rounded-lg border border-border bg-surface" hidden={!enStock} data-btn-agregar>
                            <button type="button" data-cantidad-menos aria-label="Quitar una unidad" class="flex size-11 cursor-pointer items-center justify-center text-lg text-muted transition-colors hover:text-primary">−</button>
                            <input
                                type="number"
                                data-cantidad
                                value="1"
                                min="1"
                                max="99"
                                aria-label="Cantidad"
                                class="w-12 border-0 bg-transparent text-center font-semibold text-foreground tabular-nums [appearance:textfield] focus:outline-none [&::-webkit-inner-spin-button]:appearance-none"
                            />
                            <button type="button" data-cantidad-mas aria-label="Agregar una unidad" class="flex size-11 cursor-pointer items-center justify-center text-lg text-muted transition-colors hover:text-primary">+</button>
                        </div>

                        <button
                            type="button"
                            data-add-to-cart={initialAddToCartId}
                            data-btn-agregar
                            hidden={!enStock}
                            class="brillo-cta flex-1 cursor-pointer rounded-lg bg-cta px-7 py-3.5 font-semibold text-cta-contrast transition-colors hover:bg-green-600"
                        >
                            Agregar al carrito
                        </button>

                        <a
                            href="/contacto"
                            data-btn-cotizar
                            hidden={enStock}
                            class="brillo-cta flex-1 rounded-lg bg-cta px-7 py-3.5 text-center font-semibold text-cta-contrast transition-colors hover:bg-green-600"
                        >
                            Cotizar disponibilidad
                        </a>
                    </div>

                    <a
                        href={consultaHref}
                        data-btn-consulta
                        data-whatsapp={import.meta.env.PUBLIC_WHATSAPP || ''}
                        data-nombre-producto={product.name}
                        class="mt-3 flex items-center justify-center gap-2 rounded-lg border-[1.5px] border-border px-7 py-3.5 font-semibold text-primary transition-colors hover:bg-surface-alt"
                    >
                        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-8.5 8.5 8.6 8.6 0 0 1-3.9-.9L3 21l1.9-5.6A8.5 8.5 0 1 1 21 11.5Z"/></svg>
                        {hayWhatsApp ? 'Consultar por WhatsApp' : 'Consultar por este producto'}
                    </a>

                    {/* Respaldos: el momento de decidir la compra es donde más
                        pesa saber que hay alguien detrás del producto. */}
                    <ul class="mt-8 flex flex-col divide-y divide-border border-y border-border">
                        {respaldos.map((r) => (
                            <li class="flex items-start gap-3.5 py-3.5">
                                <span class="mt-0.5 flex size-9 shrink-0 items-center justify-center rounded-full bg-green-50 text-isotipo">
                                    {r.icono === 'chat' && <svg class="size-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-8.5 8.5 8.6 8.6 0 0 1-3.9-.9L3 21l1.9-5.6A8.5 8.5 0 1 1 21 11.5Z"/></svg>}
                                    {r.icono === 'gear' && <svg class="size-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.6 1.6 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.6 1.6 0 0 0-2.7 1.1V21a2 2 0 1 1-4 0v-.1a1.6 1.6 0 0 0-2.7-1.1l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.6 1.6 0 0 0-1.1-2.7H3a2 2 0 1 1 0-4h.1a1.6 1.6 0 0 0 1.1-2.7l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.6 1.6 0 0 0 1.8.3H9a1.6 1.6 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.6 1.6 0 0 0 2.7 1.1l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.6 1.6 0 0 0-.3 1.8V9a1.6 1.6 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.6 1.6 0 0 0-1.5 1Z"/></svg>}
                                    {r.icono === 'truck' && <svg class="size-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 17h4V5H2v12h3"/><path d="M14 8h4l3 4v5h-3"/><circle cx="7.5" cy="17.5" r="1.5"/><circle cx="17.5" cy="17.5" r="1.5"/></svg>}
                                </span>
                                <div class="min-w-0">
                                    <p class="text-sm font-semibold text-foreground">{r.titulo}</p>
                                    <p class="text-[13px] leading-snug text-muted">{r.detalle}</p>
                                </div>
                            </li>
                        ))}
                    </ul>
                </div>
            </div>

            {/* ---------- Descripción + ficha técnica ----------
                En dos columnas a propósito: en una sola, la descripción de Woo
                quedaba como una franja angosta de texto con media pantalla
                vacía al lado. */}
            {(descripcionHTML || especificaciones.length > 0) && (
                <div class="mt-16 grid gap-10 lg:grid-cols-[1fr_340px]">
                    <div data-anim>
                        {descripcionHTML && (
                            <Fragment>
                                <h2 class="font-display text-2xl font-semibold text-primary">Descripción</h2>
                                <div class="mt-1.5 h-1 w-12 rounded-full bg-gold-500"></div>
                                <div class:list={["mt-5 max-w-prose text-foreground", contenidoWP]} set:html={descripcionHTML} />
                            </Fragment>
                        )}
                    </div>

                    <div class="flex flex-col gap-4" data-anim="fade-left" data-anim-delay="0.1">
                        {especificaciones.length > 0 && (
                            <div class="rounded-2xl border border-border bg-surface p-6">
                                <h2 class="font-mono text-xs tracking-[0.16em] text-muted">FICHA TÉCNICA</h2>
                                <dl class="mt-4 divide-y divide-border">
                                    {especificaciones.map((spec) => (
                                        <div class="flex items-baseline justify-between gap-6 py-2.5">
                                            <dt class="text-sm text-muted">{spec.k}</dt>
                                            <dd
                                                class="text-right text-sm font-medium text-foreground"
                                                data-spec-sku={spec.k === 'SKU' ? '' : undefined}
                                            >
                                                {spec.v}
                                            </dd>
                                        </div>
                                    ))}
                                </dl>
                            </div>
                        )}

                        <div class="rounded-2xl border border-earth-500/20 bg-earth-50 p-6">
                            <p class="font-mono text-[10px] tracking-[0.08em] text-substrate">¿DUDAS CON ESTE PRODUCTO?</p>
                            <p class="mt-2.5 text-sm leading-relaxed text-foreground">
                                Si no estás seguro de que sea lo que necesitas, cuéntanos para
                                qué lo vas a usar y te decimos si es el correcto.
                            </p>
                            <a href={consultaHref} class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-substrate transition-colors hover:text-earth-700">
                                Pedir asesoría →
                            </a>
                        </div>
                    </div>
                </div>
            )}

            {/* ---------- Podrían interesarte ---------- */}
            {relacionados.length > 0 && (
                <section class="mt-16 border-t border-border pt-12">
                    <div class="mb-6 flex items-end justify-between gap-4" data-anim>
                        <div>
                            <p class="font-mono text-[11px] tracking-[0.16em] text-isotipo">DE LA MISMA CATEGORÍA</p>
                            <h2 class="mt-1.5 font-display text-2xl font-semibold text-primary md:text-3xl">
                                Productos que podrían interesarte
                            </h2>
                        </div>
                        {categoria && (
                            <a href={`/tienda/${categoria.slug}`} class="group text-sm font-medium whitespace-nowrap text-isotipo transition-colors hover:text-primary">
                                Ver {categoria.name}
                                <span class="inline-block transition-transform duration-300 group-hover:translate-x-1">→</span>
                            </a>
                        )}
                    </div>

                    <div class="grid grid-cols-2 gap-5 lg:grid-cols-4" data-anim-stagger>
                        {relacionados.map((p) => (
                            <ProductCard product={p} category={p.categories?.[0]?.name} />
                        ))}
                    </div>
                </section>
            )}
        </div>
    </div>
</Layout>

<style>
    /* Mismo lavado radial que la tienda, para que la ficha no se sienta un
       plano de un solo color. Es decoración: va detrás de todo. */
    .ficha-fondo {
        background-color: var(--color-background);
        background-image:
            radial-gradient(56rem 32rem at 10% 0%, color-mix(in srgb, var(--color-cta) 9%, transparent), transparent 60%),
            radial-gradient(44rem 28rem at 100% 100%, color-mix(in srgb, var(--color-gold-500) 7%, transparent), transparent 55%);
        background-repeat: no-repeat;
    }
</style>

<script>
    // Galería, selector de cantidad y sincronización reactiva de variantes.
    import { aparecer } from '@/lib/animaciones';
    import { formatoMonedaCLP, calcularDescuento } from '@/lib/variantes';
    import type { WooVariation } from '@/lib/api';

    // El listener del cambio de variante se registra en `document`, que el
    // ClientRouter NO reemplaza al navegar. Añadido en cada astro:page-load, se
    // acumulaba una copia por cada ficha visitada, cada una atada a la galería
    // de su página (ya fuera del DOM). Se guarda aquí para quitar el anterior.
    let alSeleccionarVariante: ((e: Event) => void) | null = null;

    function initFicha() {
        const main = document.querySelector<HTMLImageElement>('[data-main-image]');
        const galeria = document.querySelector<HTMLElement>('[data-galeria-miniaturas]');

        function vincularMiniaturas() {
            if (!main || !galeria) return;
            const botones = galeria.querySelectorAll<HTMLButtonElement>('[data-thumb]');
            botones.forEach((btn) => {
                btn.onclick = () => {
                    const src = btn.dataset.thumb;
                    if (!src || main.src === src) return;

                    main.src = src;
                    aparecer(main, { y: 0, scale: 1.02, duration: 0.35 });

                    // Marca cuál se está viendo.
                    botones.forEach((b) => {
                        b.classList.toggle('border-isotipo', b === btn);
                        b.classList.toggle('border-border', b !== btn);
                    });
                };
            });
        }

        vincularMiniaturas();

        // Precarga silenciosa en segundo plano de las imágenes de todas las variantes:
        // Garantiza que cuando el usuario haga clic en cualquier opción, la imagen
        // ya resida en la memoria caché del navegador para una transición instantánea y fluida.
        const scriptVariantes = document.querySelector<HTMLScriptElement>('[data-variantes-json]');
        if (scriptVariantes?.textContent) {
            try {
                const lista = JSON.parse(scriptVariantes.textContent);
                const urls = new Set<string>();
                lista.forEach((v: { images?: { src: string }[]; image?: { src: string } }) => {
                    if (Array.isArray(v.images)) {
                        v.images.forEach((img) => img?.src && urls.add(img.src));
                    } else if (v.image?.src) {
                        urls.add(v.image.src);
                    }
                });
                urls.forEach((url) => {
                    const img = new Image();
                    img.src = url;
                });
            } catch {}
        }

        // Cantidad: los botones ± con el input como única fuente de verdad.
        const campo = document.querySelector<HTMLInputElement>('[data-cantidad]');
        if (campo) {
            const mueve = (paso: number) => {
                const actual = Number(campo.value) || 1;
                campo.value = String(Math.min(99, Math.max(1, actual + paso)));
            };

            document.querySelector('[data-cantidad-menos]')?.addEventListener('click', () => mueve(-1));
            document.querySelector('[data-cantidad-mas]')?.addEventListener('click', () => mueve(1));

            // Escribir a mano un valor inválido no debe llegar al carrito.
            campo.addEventListener('change', () => mueve(0));
        }

        // Sincronización reactiva cuando el usuario elige una variante en SelectorVariantes
        if (alSeleccionarVariante) {
            document.removeEventListener('ecollifen:variante-seleccionada', alSeleccionarVariante);
        }

        alSeleccionarVariante = (e: Event) => {
            const custom = e as CustomEvent<{
                variante: WooVariation & { images?: { src: string; alt?: string }[] };
                productoId: number;
                nombreProducto: string;
            }>;
            const { variante, nombreProducto, productoId } = custom.detail;

            // Solo el selector de ESTA ficha manda sobre su precio y su botón.
            // Sin el filtro, cualquier otro selector de la página (hoy no hay,
            // pero la vista rápida es candidata) cambiaría el producto que se
            // agrega al carrito aquí.
            const panel = document.querySelector<HTMLElement>('[data-panel-compra]');
            if (!variante || !panel || Number(panel.dataset.id) !== productoId) return;

            // 1. Actualizar Precio vigente
            const elPrecio = document.querySelector('[data-precio]');
            if (elPrecio) {
                elPrecio.textContent = formatoMonedaCLP(variante.price);
            }

            // 2. Actualizar Precio tachado y badge de descuento
            const elPrecioNormal = document.querySelector('[data-precio-normal]');
            const elBadge = document.querySelector('[data-descuento-badge]');
            const { hayDescuento, porcentaje } = calcularDescuento(variante.price, variante.regular_price);

            if (elPrecioNormal) {
                elPrecioNormal.textContent = formatoMonedaCLP(variante.regular_price);
                elPrecioNormal.toggleAttribute('hidden', !hayDescuento);
            }
            if (elBadge) {
                elBadge.textContent = `−${porcentaje}%`;
                elBadge.toggleAttribute('hidden', !hayDescuento);
            }

            // 3. Actualizar SKU
            const sku = variante.sku || '';
            const elSku = document.querySelector('[data-sku]');
            if (elSku) {
                elSku.textContent = sku ? `SKU · ${sku}` : '';
                elSku.toggleAttribute('hidden', !sku);
            }
            const elSpecSku = document.querySelector('[data-spec-sku]');
            if (elSpecSku) {
                elSpecSku.textContent = sku;
            }

            // 4. Actualizar Chip de estado de stock
            const enStock = variante.stock_status === 'instock';
            const esBajoPedido = variante.stock_status === 'onbackorder';
            const elEstado = document.querySelector('[data-estado]');
            if (elEstado) {
                if (enStock) {
                    elEstado.textContent = '● En stock';
                    elEstado.className = 'inline-flex items-center gap-1.5 rounded-full border px-3 py-1 font-mono text-[11px] font-medium border-green-200 bg-green-50 text-green-700';
                } else if (esBajoPedido) {
                    elEstado.textContent = '● Bajo pedido';
                    elEstado.className = 'inline-flex items-center gap-1.5 rounded-full border px-3 py-1 font-mono text-[11px] font-medium border-gold-200 bg-gold-50 text-gold-700';
                } else {
                    elEstado.textContent = '● Sin stock';
                    elEstado.className = 'inline-flex items-center gap-1.5 rounded-full border px-3 py-1 font-mono text-[11px] font-medium border-border bg-surface-alt text-muted';
                }
            }

            // 5. Actualizar botones de compra (ID de variante para Store API)
            const elementosAgregar = document.querySelectorAll('[data-btn-agregar]');
            const elCotizar = document.querySelector('[data-btn-cotizar]');
            const elAddToCart = document.querySelector('[data-add-to-cart]');

            if (elAddToCart) {
                elAddToCart.setAttribute('data-add-to-cart', String(variante.id));
            }
            elementosAgregar.forEach((el) => {
                el.toggleAttribute('hidden', !enStock);
            });
            if (elCotizar) {
                elCotizar.toggleAttribute('hidden', enStock);
            }

            // 6. Actualizar enlace dinámico de WhatsApp
            const elConsulta = document.querySelector<HTMLAnchorElement>('[data-btn-consulta]');
            if (elConsulta) {
                const whatsapp = elConsulta.dataset.whatsapp;
                const opcionTexto = (variante.attributes || [])
                    .map((a) => a.option)
                    .filter(Boolean)
                    .join(', ');
                const urlActual = window.location.href;
                const msj = `Hola, quiero asesoría por el producto "${nombreProducto}${opcionTexto ? ` - ${opcionTexto}` : ''}"${sku ? ` (SKU ${sku})` : ''}: ${urlActual}`;
                if (whatsapp) {
                    elConsulta.href = `https://wa.me/${whatsapp}?text=${encodeURIComponent(msj)}`;
                }
            }

            // 7. Actualizar Galería de imágenes (principal y miniaturas según la variante)
            let fotosVariante: { src: string; alt?: string }[] | null = (variante.images && variante.images.length > 0)
                ? variante.images
                : (variante.image?.src ? [variante.image] : null);

            // Si la variante no trae fotos específicas, restaurar las fotos originales del producto
            if (!fotosVariante && galeria?.dataset.fotosProducto) {
                try {
                    fotosVariante = JSON.parse(galeria.dataset.fotosProducto);
                } catch {}
            }

            if (fotosVariante && fotosVariante.length > 0) {
                const primeraFoto = fotosVariante[0].src;
                if (main && main.src !== primeraFoto) {
                    main.src = primeraFoto;
                    aparecer(main, { y: 0, scale: 1.02, duration: 0.35 });
                }

                if (galeria) {
                    if (fotosVariante.length > 1) {
                        galeria.hidden = false;
                        galeria.innerHTML = fotosVariante.map((img, i) => `
                            <button
                                type="button"
                                data-thumb="${img.src}"
                                aria-label="Ver imagen ${i + 1} de ${fotosVariante.length}"
                                class="size-18 cursor-pointer overflow-hidden rounded-lg border-[1.5px] bg-white p-1.5 transition-colors ${i === 0 ? 'border-isotipo' : 'border-border hover:border-green-300'}"
                            >
                                <img src="${img.src}" alt="${img.alt || ''}" class="h-full w-full object-contain" loading="lazy" />
                            </button>
                        `).join('');
                        vincularMiniaturas();
                    } else {
                        galeria.hidden = true;
                    }
                }
            } else if (main && galeria) {
                const miniaturas = galeria.querySelectorAll<HTMLButtonElement>('[data-thumb]');
                miniaturas.forEach((btn) => {
                    const coincide = btn.dataset.thumb === main.src;
                    btn.classList.toggle('border-isotipo', coincide);
                    btn.classList.toggle('border-border', !coincide);
                });
            }
        };

        document.addEventListener('ecollifen:variante-seleccionada', alSeleccionarVariante);
    }

    document.addEventListener('astro:page-load', initFicha);
</script>
