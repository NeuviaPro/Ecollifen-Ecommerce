---
// Hero-slider. Cada slide (imagen, título, bajada) viene de WordPress (CPT slide,
// ACF). La estructura fija (eyebrow, CTAs, sello, beneficios) vive en el código,
// así se cambia "solo la imagen y el texto" desde WP. Abre el funnel de ventas:
// necesidad → asesoría → solución.
//
// El carrusel lo maneja Swiper (crossfade + flechas + puntos + auto-avance).
import { getWPSlides } from '@/lib/api'
import { Picture } from 'astro:assets';
import { asesoriaHref } from '@/lib/contacto';

let heroSlides;
try {
    heroSlides = await getWPSlides();
} catch (error) {
    console.error('[hero] No se pudieron cargar los slides:', error);
}

// Fallback: si no hay slides en WP, un slide por defecto con la bajada comercial.
const slides = (heroSlides && heroSlides.length > 0)
    ? heroSlides.map((s) => ({ titulo: s.acf.titulo, descripcion: s.acf.descripcion, url: s.acf.url }))
    : [{
        titulo: 'Elige mejor antes de trabajar la tierra',
        descripcion: 'Productos, maquinaria y asesoría técnica para huertos, jardines, invernaderos y campo. Te ayudamos a encontrar la solución correcta antes de comprar.',
        url: null as string | null,
    }];

const beneficios = [
    { texto: 'Asesoría técnica especializada', icon: 'chat' },
    { texto: 'Servicio técnico y postventa', icon: 'gear' },
    { texto: 'Despacho a todo Chile', icon: 'truck' },
    { texto: 'Productos para campo, jardín e invernadero', icon: 'plant' },
];
---

<section class="bg-primary text-white">
    <div class="hero-swiper swiper relative min-h-[560px] md:min-h-[600px]" data-hero-swiper data-slides={slides.length}>
        <div class="swiper-wrapper">
            {slides.map((slide, i) => (
                <div class="swiper-slide">
                    {slide.url ? (
                        <Picture
                            src={slide.url}
                            inferSize
                            formats={['avif', 'webp']}
                            widths={[768, 1280, 1920]}
                            sizes="100vw"
                            alt={slide.titulo}
                            loading={i === 0 ? 'eager' : 'lazy'}
                            class="absolute inset-0 h-full w-full object-cover"
                        />
                    ) : (
                        <div class="absolute inset-0 bg-[repeating-linear-gradient(115deg,#1a4526_0_22px,#173f22_22px_44px)]"></div>
                    )}

                    {/* Velo verde: oscuro a la izquierda para el texto */}
                    <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(10,30,16,.94)_0%,rgba(10,30,16,.6)_48%,rgba(10,30,16,.15)_100%)]"></div>

                    {/* Contenido */}
                    <div class="relative flex min-h-[560px] items-center md:min-h-[600px]">
                        <div class="mx-auto w-full max-w-6xl px-6 py-16">
                            <p class="font-mono text-xs tracking-[0.2em] text-green-300">
                                AGRICULTURA · JARDINERÍA · INVERNADEROS · ÁREAS VERDES
                            </p>
                            <h1 class="mt-4 max-w-2xl font-display text-4xl font-semibold text-balance md:text-6xl">
                                {slide.titulo}
                            </h1>
                            <div class="mt-4 h-1 w-16 rounded-full bg-gold-500"></div>
                            <p class="mt-5 max-w-xl text-lg text-green-100/90">
                                {slide.descripcion}
                            </p>

                            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                                <a
                                    href={asesoriaHref()}
                                    class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-cta px-7 py-4 font-semibold text-primary transition-colors hover:bg-green-600 hover:text-white sm:w-auto"
                                >
                                    <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-8.5 8.5 8.6 8.6 0 0 1-3.9-.9L3 21l1.9-5.6A8.5 8.5 0 1 1 21 11.5Z"/></svg>
                                    Solicitar asesoría técnica
                                </a>
                                <a
                                    href="/tienda"
                                    class="inline-flex w-full items-center justify-center gap-2 rounded-lg border-[1.5px] border-white/60 px-7 py-4 font-semibold text-white transition-colors hover:bg-white/10 sm:w-auto"
                                >
                                    <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                                    Explorar productos
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            ))}
        </div>

        {/* Sello 6 años (fijo, sobre el slider) */}
        <div class="pointer-events-none absolute top-6 right-6 z-20 hidden size-28 flex-col items-center justify-center rounded-full border-2 border-gold-500/70 bg-green-950/40 text-center backdrop-blur-sm md:flex">
            <span class="font-display text-2xl leading-none font-bold text-gold-500">6</span>
            <span class="font-mono text-[9px] tracking-widest text-gold-200">AÑOS</span>
            <span class="mt-1 px-2 font-mono text-[7px] leading-tight tracking-wide text-green-100/80 uppercase">Cuidando tu tierra · Sur de Chile</span>
        </div>

        {/* Controles: solo tienen sentido con más de un slide */}
        {slides.length > 1 && (
            <>
                <button data-hero-prev type="button" aria-label="Anterior" class="absolute top-1/2 left-3 z-20 flex size-10 -translate-y-1/2 items-center justify-center rounded-full bg-black/30 text-white transition-colors hover:bg-black/50">
                    <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M15 18l-6-6 6-6"/></svg>
                </button>
                <button data-hero-next type="button" aria-label="Siguiente" class="absolute top-1/2 right-3 z-20 flex size-10 -translate-y-1/2 items-center justify-center rounded-full bg-black/30 text-white transition-colors hover:bg-black/50">
                    <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M9 6l6 6-6 6"/></svg>
                </button>
                <div data-hero-paginacion class="absolute bottom-5 left-1/2 z-20 flex -translate-x-1/2 gap-2"></div>
            </>
        )}
    </div>

    {/* Tira de beneficios */}
    <div class="border-t border-white/10">
        <ul class="mx-auto grid max-w-6xl gap-y-4 px-6 py-6 sm:grid-cols-2 lg:grid-cols-4">
            {beneficios.map((b) => (
                <li class="flex items-center gap-3">
                    <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-cta text-primary">
                        {b.icon === 'chat' && <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-8.5 8.5 8.6 8.6 0 0 1-3.9-.9L3 21l1.9-5.6A8.5 8.5 0 1 1 21 11.5Z"/></svg>}
                        {b.icon === 'gear' && <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.6 1.6 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.6 1.6 0 0 0-2.7 1.1V21a2 2 0 1 1-4 0v-.1a1.6 1.6 0 0 0-2.7-1.1l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.6 1.6 0 0 0-1.1-2.7H3a2 2 0 1 1 0-4h.1a1.6 1.6 0 0 0 1.1-2.7l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.6 1.6 0 0 0 1.8.3H9a1.6 1.6 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.6 1.6 0 0 0 2.7 1.1l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.6 1.6 0 0 0-.3 1.8V9a1.6 1.6 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.6 1.6 0 0 0-1.5 1Z"/></svg>}
                        {b.icon === 'truck' && <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 17h4V5H2v12h3"/><path d="M14 8h4l3 4v5h-3"/><circle cx="7.5" cy="17.5" r="1.5"/><circle cx="17.5" cy="17.5" r="1.5"/></svg>}
                        {b.icon === 'plant' && <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22V12"/><path d="M12 12c0-3 2-5 6-5 0 3-2 5-6 5Z"/><path d="M12 14c0-3-2-5-6-5 0 3 2 5 6 5Z"/></svg>}
                    </span>
                    <span class="text-sm text-green-100">{b.texto}</span>
                </li>
            ))}
        </ul>
    </div>
</section>

<style is:global>
    /* Los puntos los crea Swiper por JS, así que el estilo no puede ir scoped. */
    .hero-swiper .swiper-pagination-bullet {
        width: 8px;
        height: 8px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.4);
        opacity: 1;
        transition: width 0.25s ease, background-color 0.25s ease;
        cursor: pointer;
    }
    .hero-swiper .swiper-pagination-bullet-active {
        width: 24px;
        background: #fff;
    }
</style>

<script>
    // Swiper del hero: crossfade, flechas, puntos y auto-avance cada 6 s.
    // Se reinicia en cada navegación del ClientRouter, destruyendo la instancia
    // anterior para no dejar temporizadores huérfanos.
    import Swiper from 'swiper';
    import { Autoplay, EffectFade, Navigation, Pagination } from 'swiper/modules';
    import 'swiper/css';
    import 'swiper/css/effect-fade';

    let instancia: Swiper | null = null;

    function initHero() {
        instancia?.destroy(true, true);
        instancia = null;

        const el = document.querySelector<HTMLElement>('[data-hero-swiper]');
        if (!el) return;

        const total = Number(el.dataset.slides ?? '1');

        instancia = new Swiper(el, {
            modules: [Autoplay, EffectFade, Navigation, Pagination],
            effect: 'fade',
            fadeEffect: { crossFade: true },
            speed: 700,
            loop: total > 1,
            // Con un solo slide no hay nada que rotar ni que controlar.
            autoplay: total > 1 ? { delay: 6000, disableOnInteraction: false } : false,
            navigation: total > 1 ? {
                prevEl: '[data-hero-prev]',
                nextEl: '[data-hero-next]',
            } : false,
            pagination: total > 1 ? {
                el: '[data-hero-paginacion]',
                clickable: true,
            } : false,
        });
    }

    document.addEventListener('astro:page-load', initHero);
</script>
