---
// Precio y stock en vivo.
//
// El sitio es estático: precios y stock quedan congelados en el build. Si el
// jefe cambia un precio en WooCommerce, la página mostraría el viejo mientras
// el carrito cobra el nuevo. Este script corrige esa diferencia al vuelo:
// consulta la Store API pública (la misma del carrito, sin claves) por los
// productos visibles y actualiza lo que haya cambiado.
//
// Si la API no responde, no pasa nada: se quedan los valores del build.
---

<script>
    const BASE = `${import.meta.env.PUBLIC_WP_URL}/wp-json/wc/store/v1`;

    const money = new Intl.NumberFormat('es-CL', {
        style: 'currency',
        currency: 'CLP',
        maximumFractionDigits: 0,
    });

    const ESTADOS = {
        instock:     { label: 'En stock',    clase: 'text-isotipo' },
        onbackorder: { label: 'Bajo pedido', clase: 'text-gold-700' },
        outofstock:  { label: 'Sin stock',   clase: 'text-muted' },
    };
    const CLASES_ESTADO = ['text-isotipo', 'text-gold-700', 'text-muted'];

    function aPesos(precio: string, minorUnit: number): number {
        return Number(precio) / 10 ** (minorUnit ?? 0);
    }

    function actualizaNodo(nodo: Element, precio: number, estado: keyof typeof ESTADOS) {
        const elPrecio = nodo.querySelector('[data-precio]');
        if (elPrecio && precio > 0) {
            const nuevo = money.format(precio);
            if (elPrecio.textContent?.trim() !== nuevo) elPrecio.textContent = nuevo;
        }

        const elEstado = nodo.querySelector('[data-estado]');
        const info = ESTADOS[estado] ?? ESTADOS.outofstock;
        if (elEstado && !elEstado.textContent?.includes(info.label)) {
            elEstado.textContent = `● ${info.label}`;
            elEstado.classList.remove(...CLASES_ESTADO);
            elEstado.classList.add(info.clase);
        }

        // El botón de compra sigue al stock: sin stock, se ofrece cotizar.
        const agregar = nodo.querySelector('[data-btn-agregar]');
        const cotizar = nodo.querySelector('[data-btn-cotizar]');
        if (agregar && cotizar) {
            const disponible = estado === 'instock';
            agregar.toggleAttribute('hidden', !disponible);
            cotizar.toggleAttribute('hidden', disponible);
        }
    }

    async function sincroniza() {
        const nodos = Array.from(document.querySelectorAll('[data-id][data-price]'));
        if (nodos.length === 0) return;

        const ids = [...new Set(nodos.map((n) => n.getAttribute('data-id')).filter(Boolean))];
        if (ids.length === 0) return;

        try {
            // La Store API tope 100 por petición; el catálogo pagina de a 15
            // visibles, pero el DOM puede traer más, así que se parte en lotes.
            for (let i = 0; i < ids.length; i += 100) {
                const lote = ids.slice(i, i + 100);
                const res = await fetch(`${BASE}/products?include=${lote.join(',')}&per_page=100`);
                if (!res.ok) return;

                const productos = await res.json();
                for (const p of productos) {
                    const precio = aPesos(p.prices?.price ?? '0', p.prices?.currency_minor_unit ?? 0);
                    const estado = p.is_in_stock
                        ? (p.is_on_backorder ? 'onbackorder' : 'instock')
                        : 'outofstock';

                    document.querySelectorAll(`[data-id="${p.id}"][data-price]`)
                        .forEach((nodo) => actualizaNodo(nodo, precio, estado));
                }
            }
        } catch (error) {
            // Sin conexión con WordPress se conservan los datos del build.
            console.warn('[precios] No se pudo sincronizar con la tienda:', error);
        }
    }

    document.addEventListener('astro:page-load', sincroniza);
</script>
