---
import FooterBox from "./FooterBox.astro";
import type { FooterLink } from "./FooterBox.astro";
import { getAllWooCategories, getCatalogoCompleto } from "@/lib/api";
import { areasDeTienda, conteosDeRama } from "@/lib/categorias";
import { redesSociales } from "@/lib/contacto";
import MercadoPago from "@/assets/metodosPagos/mercadoPago.svg";

type FooterColumn = {
    title: string,
    items: FooterLink[],
}

// Los enlaces de Tienda salen de WooCommerce, no de una lista escrita a mano:
// estaban apuntando a "/tienda/agricola", un slug que dejó de existir al
// reordenar el catálogo (pasó a ser "huertos-y-agricolas") y quedó en 404.
// Se muestran las 3 áreas con más catálogo; ambas llamadas están memoizadas.
let areasDestacadas: { name: string, slug: string }[] = [];
try {
    const [categorias, productos] = await Promise.all([
        getAllWooCategories(),
        getCatalogoCompleto(),
    ]);
    areasDestacadas = areasDeTienda(categorias, conteosDeRama(categorias, productos))
        .sort((a, b) => b.count - a.count)
        .slice(0, 3);
} catch (error) {
    console.error('[footer] No se pudieron cargar las categorías:', error);
}

const columns: FooterColumn[] = [
    {
        title: 'Tienda',
        items: [
            ...areasDestacadas.map((area) => ({
                name: area.name,
                href: `/tienda/${area.slug}`,
            })),
            { name: 'Ver todo el catálogo', href: '/tienda' },
        ],
    },
    {
        title: 'Servicio técnico',
        items: [
            { name: 'Qué resolvemos', href: '/servicio-tecnico' },
            { name: 'Cómo funciona', href: '/servicio-tecnico' },
            { name: 'Cobertura', href: '/servicio-tecnico' },
            { name: 'Agendar servicio', href: '/servicio-tecnico' },
        ],
    },
    {
        title: 'Empresa',
        items: [
            { name: 'Nosotros', href: '/nosotros' },
            { name: 'Solicitar asesoría', href: '/contacto' },
            { name: 'ventasecollifen@gmail.com', href: 'mailto:ventasecollifen@gmail.com' },
        ],
    },
];

// Trazos de cada icono. Se guardan aqui y no en el markup para que la lista de
// redes (que sale del .env) siga siendo la unica fuente de verdad.
const ICONOS: Record<string, string> = {
    whatsapp: 'M21 11.5a8.4 8.4 0 0 1-8.5 8.5 8.6 8.6 0 0 1-3.9-.9L3 21l1.9-5.6A8.5 8.5 0 1 1 21 11.5Z',
    instagram: 'M7.5 3h9A4.5 4.5 0 0 1 21 7.5v9a4.5 4.5 0 0 1-4.5 4.5h-9A4.5 4.5 0 0 1 3 16.5v-9A4.5 4.5 0 0 1 7.5 3Zm9.25 3.25h.01M12 8.4a3.6 3.6 0 1 1 0 7.2 3.6 3.6 0 0 1 0-7.2Z',
    facebook: 'M14.5 8.5V7a1.5 1.5 0 0 1 1.5-1.5h1.5V3H15a4 4 0 0 0-4 4v1.5H9V12h2v9h3.5v-9H17l.5-3.5h-3Z',
};
---

<footer class="bg-primary text-primary-contrast">
    <div class="mx-auto max-w-6xl px-6 py-10 sm:py-14">
        {/* En móvil las tres listas van una debajo de otra y centradas, así que
            necesitan una línea que las separe: sin ella se leen como un solo
            bloque largo de enlaces. Desde sm son columnas y la separación la da
            la propia grilla, por eso el borde se apaga. */}
        <div class="grid grid-cols-1 gap-7 sm:grid-cols-2 sm:gap-10 lg:grid-cols-4 [&>*+*]:border-t [&>*+*]:border-cream-50/10 [&>*+*]:pt-7 sm:[&>*+*]:border-0 sm:[&>*+*]:pt-0">
            {columns.map( (column) =>
                <FooterBox title={column.title} items={column.items} />
            )}

            {/* Redes. La lista sale del .env (ver redesSociales en @/lib/contacto):
                hoy solo hay WhatsApp configurado, y las demas apareceran solas
                cuando el cliente entregue sus cuentas. No se pintan perfiles
                inventados ni iconos que no lleven a ninguna parte. */}
            {redesSociales.length > 0 && (
                <div class="flex flex-col items-center gap-3.5 text-center sm:items-start sm:gap-4 sm:text-left">
                    <h3 class="font-mono text-xs tracking-[0.16em] text-green-300 uppercase">
                        Redes sociales
                    </h3>
                    <ul class="flex flex-col gap-0.5 sm:gap-1">
                        {redesSociales.map((red) => (
                            <li>
                                <a
                                    href={red.href}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="inline-flex items-center gap-2.5 py-1 text-[15px] text-cream-200/75 transition-colors hover:text-cream-50 sm:text-sm"
                                >
                                    <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d={ICONOS[red.icono]} />
                                    </svg>
                                    {red.nombre}
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>
            )}
        </div>

        {/* Medios de pago. Va bajo las columnas y sobre la linea legal, que es
            donde se busca al final de una tienda. */}
        <div class="mt-9 flex flex-col items-center gap-3 border-t border-cream-50/10 pt-7 sm:mt-12">
            <p class="font-mono text-[11px] tracking-[0.16em] text-green-300 uppercase">
                Medios de pago
            </p>
            <MercadoPago
                role="img"
                aria-label="Mercado Pago"
                class="h-16 w-auto"
            />
        </div>

        <div class="mt-7 flex flex-col items-center gap-2 pt-1 text-center sm:flex-row sm:justify-center sm:gap-2.5">
            <p class="text-xs text-cream-200/60">
                &copy; { new Date().getFullYear() } Ecollifén SpA · Todos los derechos reservados. Página creada por NeuviaPro
            </p>
            <span class="hidden text-cream-200/30 sm:inline" aria-hidden="true">·</span>
            <p class="font-display text-sm text-green-300 italic">
                Soluciones que echan raíces.
            </p>
        </div>
    </div>
</footer>
