# Reglas para el sitio Astro estático en la raíz del dominio.
# OJO: WordPress vive en /wp y tiene su propio .htaccess, que manda dentro de
# esa carpeta. Aquí no se toca nada de WordPress.
#
# Este archivo vive en public/ para que cada build lo copie a dist/.

# Página de error propia (la de Astro, con la identidad de la marca).
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Forzar dominio canónico sin www y con HTTPS (elimina saltos y redirecciones 3xx)
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\.ecollifen\.cl$ [NC]
    RewriteRule ^(.*)$ https://ecollifen.cl/$1 [L,R=301]

    # 2. Bloquear acceso público a archivos internos de despliegue (.cpanel.yml, .git)
    RewriteRule ^(\.cpanel\.yml|\.git) - [F,L]

    # 3. No interferir con peticiones dirigidas a /wp
    RewriteRule ^wp(/.*)?$ - [L]

    # 4. Fallback dinámico para productos nuevos en /producto/<slug>
    # (Solo se activa si creas src/pages/producto/detalle.astro y la carpeta del producto aún no existe en disco)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/producto/detalle/index.html -f
    RewriteRule ^producto/([^/]+)/?$ /producto/detalle/index.html [L,QSA]
</IfModule>

# Cabeceras de seguridad HTTP (resuelve alertas de seguridad en 263 URLs)
<IfModule mod_headers.c>
    # Prevenir Clickjacking (ataques dentro de iframes no autorizados)
    Header always set X-Frame-Options "SAMEORIGIN"

    # Prevenir que el navegador adivine el tipo MIME (MIME-sniffing)
    Header always set X-Content-Type-Options "nosniff"

    # Enviar solo el origen como referrer en peticiones cross-origin
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Forzar navegación segura HTTPS (HSTS)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# Comprimir texto: HTML, CSS, JS y SVG viajan mucho más livianos.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On

    # Los assets de /_astro/ llevan un hash en el nombre: cuando cambian, cambia
    # la URL. Por eso se pueden cachear un año sin miedo a servir algo viejo.
    <IfModule mod_headers.c>
        <FilesMatch "\.(js|css|woff2)$">
            Header set Cache-Control "public, max-age=31536000, immutable"
        </FilesMatch>
    </IfModule>

    # El HTML, en cambio, debe revalidarse: es lo que cambia en cada despliegue.
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/avif "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
</IfModule>