---
// Página de la línea Raíz Viva — marca propia de Ecollifén para sustratos y
// compost. Guiada por el diseño "Raiz Viva.dc.html" de Claude Design, con dos
// ajustes deliberados respecto del mock:
//
// 1. El diseño inventaba 4 SKUs (Sustrato, Compost, Humus de lombriz,
//    Mejorador con biochar). El cliente solo confirmó "sustratos y compost";
//    humus y mejorador con biochar no existen en ningún documento aprobado.
//    Se implementan 2 tarjetas reales + un cierre honesto que invita a
//    consultar, en vez de inventar dos productos más.
// 2. WooCommerce ya tiene la categoría `raiz-viva` (sin productos todavía).
//    Los CTA de compra apuntan ahí, no a /tienda genérico: hoy mostrará
//    "aún no hay productos" — cierto — y en cuanto se cargue el primer
//    producto, empieza a funcionar solo.
// 3. (2026-09-11) El hero pasó a una sola columna con la foto de marca
//    `raizVivaHero.png`, que reemplaza al logo en caja + la foto de ambiente.
//    El porqué está junto a la sección.
import Layout from '@/layouts/Layout.astro';
import { Image, Picture } from 'astro:assets';
import heroRaizViva from '@/assets/raizViva/raizVivaHero.png';
import productoFrente from '@/assets/raizViva/raiz-viva-producto-frente.webp';
import { asesoriaHref } from '@/lib/contacto';
import NavRaices from '@/components/raizViva/NavRaices.astro';

const CATEGORIA_HREF = '/tienda/raiz-viva';

const stats = [
    { valor: '100%', label: 'ORIGEN NATURAL' },
    { valor: '6 L – 40 L', label: 'FORMATOS' },
    { valor: 'Todo Chile', label: 'DESPACHO DE LA LÍNEA' },
    { valor: '6 años', label: 'TRABAJANDO LA TIERRA' },
];

const bullets = [
    'Contiene compost, perlita, turba y humus',
    'Raíces más sanas, plantas con vigor y cosechas abundantes',
    'Ideal para almácigos, huertos urbanos, hortalizas y trasplantes',
];

const formatos = ['6 L', '10 L', '20 L', '40 L'];

const pasos = [
    {
        n: '01',
        titulo: 'Prepara el sustrato',
        desc: 'Suelta la mezcla con las manos y humedécela ligeramente antes de llenar el almacigüero o la maceta.',
    },
    {
        n: '02',
        titulo: 'Siembra o trasplanta',
        desc: 'No necesita fertilizante adicional en las primeras semanas: la mezcla ya trae compost y humus.',
    },
    {
        n: '03',
        titulo: 'Mantén la humedad',
        desc: 'La perlita mejora el drenaje, así que riega seguido y en poca cantidad hasta el arraigue.',
    },
];
---

<Layout title="Raíz Viva">
    <NavRaices />
    {/* Hero — fondo Tierra oscuro (earth-700), CTA en Dorado por contraste:
        un botón Tierra sobre fondo Tierra casi no se distinguiría.

        Composición en UNA columna, no en dos: la foto de marca ya trae el
        logotipo "RAÍZ VIVA" a la izquierda y el producto a la derecha, así que
        es autosuficiente. Partirla en una columna la recortaría justo por el
        logotipo, y superponerle texto competiría con él (y duplicaría la
        marca). Por eso el copy va ARRIBA, centrado, y la foto debajo como
        pieza protagonista, enmarcada para que su fondo claro no choque a
        borde vivo con la tierra oscura de la sección. */}
    <section id="origen" class="hero-raiz relative isolate scroll-mt-24 overflow-hidden bg-earth-700 text-earth-50">
        {/* Capas de vida sobre la tierra. La página entera era Tierra sobre
            Tierra: el verde es el color dominante de la marca y aquí no
            aparecía por ningún lado, justo en la línea que se llama "Raíz
            VIVA". Estas capas lo devuelven sin robarle el rol a la Tierra. */}
        <div class="pointer-events-none absolute inset-0 -z-10 opacity-70 mezcla-vida"></div>

        {/* Raíz de fondo: la misma forma del nav, en grande y casi invisible.
            Ata visualmente la marca con su propia metáfora. Centrada detrás
            del texto, ahora que el hero dejó de ser de dos columnas. */}
        <svg
            class="pointer-events-none absolute -top-16 left-1/2 -z-10 h-[85%] w-auto -translate-x-1/2 text-green-500/10"
            viewBox="0 0 200 600" fill="none" aria-hidden="true"
        >
            <g stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                <path d="M100 0 C 118 90, 74 150, 100 250 C 126 350, 78 420, 100 600" />
                <path d="M100 120 C 60 140, 36 178, 22 232" />
                <path d="M100 190 C 142 212, 166 250, 178 302" />
                <path d="M100 300 C 58 326, 34 366, 24 424" />
                <path d="M100 400 C 140 424, 160 462, 168 512" />
                <path d="M22 232 C 8 254, 4 286, 10 318" stroke-width="1.5" />
                <path d="M178 302 C 192 326, 194 356, 186 386" stroke-width="1.5" />
            </g>
        </svg>

        <div class="mx-auto max-w-6xl px-6 py-16 md:py-20">
            <div class="mx-auto max-w-3xl text-center">
                <p class="font-mono text-[11px] font-semibold tracking-[0.18em] text-earth-100">
                    RAÍZ VIVA · MARCA PROPIA DE ECOLLIFÉN
                </p>

                {/* La página no tenía ningún h1: el título de marca vivía como
                    imagen del logo y el resto arrancaba en h2. */}
                <h1 class="mt-5 font-display text-4xl leading-[1.08] font-semibold text-balance text-white md:text-5xl lg:text-[3.4rem]">
                    Volver al origen,<br class="hidden sm:block" /> cuidar la <span class="text-green-300 italic">raíz</span>.
                </h1>

                <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-earth-50/85">
                    Nuestra línea de sustratos y compost, desarrollada para quienes buscan
                    mejorar la tierra de manera natural y sustentable. Formulada por
                    Ecollifén en el sur de Chile.
                </p>

                <div class="mt-9 flex flex-wrap justify-center gap-3">
                    <a
                        href={CATEGORIA_HREF}
                        class="inline-flex items-center justify-center rounded-xl bg-tech px-7 py-4 font-semibold text-tech-contrast transition-transform hover:-translate-y-0.5 hover:bg-gold-200"
                    >
                        Comprar Raíz Viva
                    </a>
                    <a
                        href="#linea"
                        class="inline-flex items-center justify-center rounded-xl border-[1.5px] border-earth-100/45 px-7 py-4 font-semibold text-earth-50 transition-colors hover:border-earth-100 hover:bg-white/10"
                    >
                        Ver la línea
                    </a>
                </div>
            </div>

            {/* Foto de marca. Es el LCP de la página: se carga con prioridad y
                sin lazy.
                En móvil gana algo de alto recortándose a 16/10 (a 2:1 nativo
                quedaría como una franja de ~170 px), pero CENTRADA y sin más
                recorte que ese: probando con 4/3 el borde izquierdo partía el
                logotipo "RAÍZ VIVA" por la mitad. Desde sm se ve completa.
                fallbackFormat="jpeg" porque el original es un PNG de 2 MB y es
                una FOTO: el fallback en PNG pesaba 2,9 MB, contra ~70 KB del
                avif equivalente. */}
            <figure class="relative mt-14 md:mt-16" data-anim>
                <div class="overflow-hidden rounded-3xl shadow-[0_36px_90px_-34px_rgba(0,0,0,.8)] ring-1 ring-earth-100/20">
                    <Picture
                        src={heroRaizViva}
                        formats={['avif', 'webp']}
                        fallbackFormat="jpeg"
                        alt="Bolsa de sustrato Raíz Viva sobre una mesa de madera, junto a almácigos, plantas y tierra, con el logotipo de la línea al costado"
                        widths={[640, 960, 1280, 1774]}
                        sizes="(min-width: 1152px) 1088px, 100vw"
                        loading="eager"
                        fetchpriority="high"
                        class="aspect-16/10 w-full object-cover object-center sm:aspect-2/1"
                    />
                </div>
            </figure>
        </div>
    </section>

    {/* Banda de cifras — Tierra (rol oficial: Sustrato/Compost) */}
    <section class="bg-substrate text-earth-50">
        <div class="mx-auto grid max-w-6xl grid-cols-2 gap-8 px-6 py-7 md:grid-cols-4" data-anim-stagger="0.07">
            {stats.map((stat) => (
                <div>
                    <p class="font-display text-2xl font-semibold text-gold-200">{stat.valor}</p>
                    <p class="mt-1 font-mono text-[11px] tracking-[0.09em] text-earth-100/90">{stat.label}</p>
                </div>
            ))}
        </div>
    </section>

    {/* La línea */}
    <section id="linea" class="mx-auto max-w-6xl scroll-mt-24 px-6 pt-16 md:pt-20">
        <div class="flex flex-col gap-6 border-b border-earth-500/20 pb-5 sm:flex-row sm:items-end sm:justify-between">
            <div>
                <p class="font-mono text-[11px] tracking-[0.14em] text-substrate">LA LÍNEA</p>
                <h2 class="mt-3 font-display text-4xl leading-tight font-semibold tracking-tight text-earth-700">
                    Sustratos y compost, hechos por Ecollifén
                </h2>
            </div>
            <p class="max-w-[36ch] text-sm leading-relaxed text-muted">
                Dos líneas para dos momentos del cultivo: partir con el pie derecho, o devolverle
                vida a un suelo que ya trabajó de más.
            </p>
        </div>

        <div class="mt-9 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3" data-anim-stagger>
            {/* Sustrato — el único con imagen y copy ya aprobados */}
            <article class="flex flex-col overflow-hidden rounded-2xl border border-earth-500/20 bg-surface transition-all duration-300 hover:-translate-y-1.5 hover:border-substrate hover:shadow-[0_20px_44px_-24px_rgba(122,59,30,.45)]">
                <div class="relative aspect-4/3 overflow-hidden border-b border-earth-500/15 bg-white">
                    <Image src={productoFrente} alt="Sustrato de Inicio Premium Raíz Viva" class="h-full w-full object-cover" />
                    <span class="absolute top-3 left-3 rounded-md bg-substrate px-2.5 py-1 font-mono text-[10px] tracking-wider text-substrate-contrast uppercase">
                        Sustrato
                    </span>
                </div>
                <div class="flex flex-1 flex-col p-5">
                    <h3 class="font-display text-xl font-semibold text-earth-700">Sustrato de Inicio Premium</h3>
                    <p class="mt-2.5 text-sm leading-relaxed text-muted">
                        Mezcla lista para siembra con compost, perlita, turba y humus. Para
                        almácigos, huerto urbano y trasplantes.
                    </p>
                    <div class="mt-4 flex flex-wrap gap-1.5">
                        {formatos.map((f) => (
                            <span class="rounded-md border border-earth-500/30 px-2.5 py-1 text-xs font-medium text-substrate">{f}</span>
                        ))}
                    </div>
                    <div class="mt-auto flex items-center justify-between gap-3 pt-5">
                        <span class="font-mono text-[11px] tracking-wide text-muted">Disponible pronto en tienda</span>
                        <a href={CATEGORIA_HREF} class="text-sm font-semibold text-substrate hover:text-earth-700">Ver →</a>
                    </div>
                </div>
            </article>

            {/* Compost — confirmado por el cliente, sin ficha ni foto todavía:
                se muestra honesto en vez de inventar formatos o descripción técnica. */}
            <article class="flex flex-col overflow-hidden rounded-2xl border border-earth-500/20 bg-surface transition-all duration-300 hover:-translate-y-1.5 hover:border-substrate hover:shadow-[0_20px_44px_-24px_rgba(122,59,30,.45)]">
                <div class="relative aspect-4/3 overflow-hidden border-b border-earth-500/15 bg-[repeating-linear-gradient(135deg,#f6ede7_0_14px,#efe2d8_14px_28px)]">
                    <span class="absolute top-3 left-3 rounded-md bg-substrate px-2.5 py-1 font-mono text-[10px] tracking-wider text-substrate-contrast uppercase">
                        Compost
                    </span>
                </div>
                <div class="flex flex-1 flex-col p-5">
                    <h3 class="font-display text-xl font-semibold text-earth-700">Compost Raíz Viva</h3>
                    <p class="mt-2.5 text-sm leading-relaxed text-muted">
                        Materia orgánica para devolverle vida a un suelo cansado. En preparación
                        junto al resto de la línea.
                    </p>
                    <div class="mt-auto flex items-center justify-between gap-3 pt-5">
                        <span class="font-mono text-[11px] tracking-wide text-muted">En preparación</span>
                        <a href="/contacto" class="text-sm font-semibold text-substrate hover:text-earth-700">Consultar →</a>
                    </div>
                </div>
            </article>

            {/* Cierre honesto en vez de dos SKUs inventados (humus, mejorador con
                biochar): invita a preguntar por lo que de verdad se necesita. */}
            <article class="flex flex-col items-start justify-center rounded-2xl border-2 border-dashed border-earth-500/30 bg-earth-50/60 p-6">
                <h3 class="font-display text-lg font-semibold text-earth-700">¿Buscas otra referencia?</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted">
                    La línea sigue creciendo. Cuéntanos qué necesita tu suelo o tu cultivo y te
                    decimos qué estamos preparando para eso.
                </p>
                <a
                    href={asesoriaHref()}
                    class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-substrate hover:text-earth-700"
                >
                    Solicitar asesoría
                    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </a>
            </article>
        </div>
    </section>

    {/* Producto estrella — mismo copy aprobado que ProductoEstrella.astro,
        con imagen a la izquierda (así lo pide el diseño para esta página). */}
    <section id="estrella" class="mx-auto max-w-6xl scroll-mt-24 px-6 pt-16 md:pt-20">
        <div class="grid items-center gap-12 overflow-hidden rounded-3xl border border-earth-500/20 bg-surface lg:grid-cols-[1fr_1.1fr]" data-anim>
            <div class="relative min-h-105 self-stretch bg-earth-100">
                <Image
                    src={productoFrente}
                    alt="Saco de sustrato Raíz Viva de frente"
                    widths={[480, 768, 1024]}
                    sizes="(min-width: 1024px) 45vw, 100vw"
                    class="absolute inset-0 h-full w-full object-cover"
                />
            </div>

            <div class="p-8 pr-8 md:p-12 md:pr-12 lg:pl-0">
                <p class="font-mono text-[11px] tracking-[0.14em] text-substrate">PRODUCTO ESTRELLA</p>
                <h2 class="mt-3 max-w-[22ch] font-display text-3xl leading-tight font-semibold text-balance text-earth-700 md:text-4xl">
                    Sustrato completo de inicio premium
                </h2>
                <p class="mt-4 max-w-prose text-muted">
                    Mezcla lista para siembra: sustrato premium que devuelve vida al suelo y da
                    resultados visibles desde el primer cultivo.
                </p>

                <ul class="mt-6 flex flex-col gap-2.5">
                    {bullets.map((bullet) => (
                        <li class="flex items-start gap-2.5 text-sm text-foreground">
                            <span class="mt-1 text-substrate">◆</span>
                            {bullet}
                        </li>
                    ))}
                </ul>

                <div class="mt-7">
                    <span class="block font-mono text-xs tracking-wide text-muted">FORMATOS</span>
                    <div class="mt-2 flex flex-wrap gap-2">
                        {formatos.map((f) => (
                            <span class="rounded-md border border-earth-500/30 px-2.5 py-1.5 text-sm font-medium text-substrate transition-colors hover:bg-earth-50">{f}</span>
                        ))}
                    </div>
                </div>

                <div class="mt-8 flex flex-wrap gap-3">
                    <a
                        href={CATEGORIA_HREF}
                        class="inline-flex items-center justify-center rounded-xl bg-substrate px-6 py-3.5 font-semibold text-substrate-contrast transition-colors hover:bg-earth-600"
                    >
                        Comprar Raíz Viva
                    </a>
                    <a
                        href="/contacto"
                        class="inline-flex items-center justify-center rounded-xl border-[1.5px] border-earth-500/35 px-6 py-3.5 font-semibold text-substrate transition-colors hover:bg-earth-50"
                    >
                        Ficha técnica
                    </a>
                </div>
            </div>
        </div>
    </section>

    {/* Cómo usarlo — guía general de siembra, no una promesa sobre un producto
        específico: bajo riesgo aunque el catálogo aún no tenga stock. */}
    <section id="uso" class="mx-auto max-w-6xl scroll-mt-24 px-6 pt-16 md:pt-20">
        <p class="font-mono text-[11px] tracking-[0.14em] text-substrate">CÓMO USARLO</p>
        <h2 class="mt-3 font-display text-4xl leading-tight font-semibold text-earth-700">
            Tres pasos, cualquier cultivo
        </h2>

        <div class="mt-9 grid grid-cols-1 gap-6 sm:grid-cols-3" data-anim-stagger>
            {pasos.map((paso) => (
                <div class="border-t-2 border-substrate pt-5">
                    <span class="font-display text-4xl leading-none font-semibold text-earth-500/30">{paso.n}</span>
                    <h3 class="mt-3 font-display text-lg font-semibold text-earth-700">{paso.titulo}</h3>
                    <p class="mt-2.5 text-sm leading-relaxed text-muted">{paso.desc}</p>
                </div>
            ))}
        </div>
    </section>

    {/* Cierre */}
    <section id="asesoria-rv" class="mx-auto max-w-6xl scroll-mt-24 px-6 pt-16 pb-20 md:pt-20">
        <div class="grid items-center gap-10 rounded-3xl bg-earth-700 p-10 text-earth-50 md:grid-cols-2 md:p-13" data-anim>
            <div>
                <h2 class="max-w-[20ch] font-display text-3xl leading-tight font-semibold text-balance text-white">
                    ¿No sabes qué sustrato necesita tu cultivo?
                </h2>
                <p class="mt-3.5 max-w-md text-earth-100/90">
                    Cuéntanos qué vas a plantar, en qué formato y dónde estás. Te decimos qué de
                    la línea corresponde.
                </p>
            </div>
            <div class="flex flex-wrap gap-3 md:justify-end">
                <a
                    href={asesoriaHref()}
                    class="inline-flex items-center justify-center rounded-xl bg-tech px-7 py-4 font-semibold text-tech-contrast transition-transform hover:-translate-y-0.5 hover:bg-gold-200"
                >
                    Solicitar asesoría
                </a>
                <a
                    href={CATEGORIA_HREF}
                    class="inline-flex items-center justify-center rounded-xl border-[1.5px] border-earth-100/45 px-7 py-4 font-semibold text-earth-50 transition-colors hover:border-earth-100 hover:bg-white/10"
                >
                    Ir a la tienda
                </a>
            </div>
        </div>
    </section>
</Layout>

<style>
    /* La "vida" del hero: dos focos verdes y uno dorado muy tenues sobre la
       tierra. Van en CSS y no en Tailwind porque son tres degradados radiales
       superpuestos — como utilidades sueltas serían ilegibles. */
    .mezcla-vida {
        background-image:
            radial-gradient(38rem 26rem at 12% 8%, color-mix(in srgb, var(--color-green-500) 26%, transparent), transparent 62%),
            radial-gradient(30rem 24rem at 78% 92%, color-mix(in srgb, var(--color-green-600) 20%, transparent), transparent 58%),
            radial-gradient(26rem 18rem at 60% 0%, color-mix(in srgb, var(--color-gold-500) 14%, transparent), transparent 60%);
    }

    /* Suelo: la sección se oscurece hacia abajo, como tierra en profundidad.
       Da volumen sin agregar ni un elemento más al DOM. */
    .hero-raiz::after {
        content: "";
        position: absolute;
        inset-inline: 0;
        bottom: 0;
        height: 45%;
        z-index: -10;
        pointer-events: none;
        background: linear-gradient(to top, color-mix(in srgb, var(--color-earth-700) 92%, black), transparent);
    }
</style>
