---
// "Lo más pedido esta temporada": la fila de producto real con precio y stock
// que el rediseño manda poner en la parte alta de la home.
//
// Ahora es un carrusel de avance continuo (Swiper). Trae lo que el cliente
// marque como "Destacado" en WooCommerce y completa con productos en stock:
// con 4 tarjetas fijas el carrusel no tenía sentido.
import { getDestacados } from '@/lib/api';

// El CSS de Swiper se importa AQUÍ, en el frontmatter, y no dentro del
// <script> de abajo. Es a propósito: importado desde el script, Vite lo inyecta
// en el <head> al ejecutar el módulo, y ese <style> no forma parte del HTML de
// la página. El ClientRouter, al navegar, borra del <head> todo lo que no venga
// en el HTML de la página nueva — y como el módulo ya se ejecutó una vez, nunca
// vuelve a inyectarlo. Resultado: al volver al inicio el carrusel quedaba sin
// estilos (las tarjetas apiladas en vertical) hasta recargar. Desde el
// frontmatter es una dependencia de estilo del componente, viaja en el HTML y
// el router la restaura en cada navegación.
import 'swiper/css';
import 'swiper/css/free-mode';
import type { WooProduct } from '@/lib/api';
import ProductCard from '@/components/product/ProductCard.astro';

let productos: WooProduct[] = [];
try {
    productos = await getDestacados(12);
} catch (error) {
    console.error('[destacados] No se pudieron cargar los productos:', error);
}
---

<section class="mx-auto max-w-6xl px-6 py-14">
    {/* Solo se revela el encabezado. Las tarjetas van dentro del carrusel y
        Swiper controla su `transform` fotograma a fotograma: animarlas por
        fuera pelearía con él y dejaría el carrusel descuadrado. */}
    <div class="mb-6 flex items-end justify-between gap-4" data-anim>
        <div>
            <p class="font-mono text-[11px] tracking-[0.16em] text-isotipo">CON PRECIO Y STOCK A LA VISTA</p>
            <h2 class="mt-1.5 font-display text-3xl font-semibold text-primary">
                Lo más pedido esta temporada
            </h2>
        </div>
        <a href="/tienda" class="group text-sm font-medium whitespace-nowrap text-isotipo transition-colors hover:text-primary">
            Ver todo el catálogo
            <span class="inline-block transition-transform duration-300 group-hover:translate-x-1">→</span>
        </a>
    </div>

    {productos.length === 0 ? (
        <p class="rounded-lg border border-border bg-surface p-6 text-muted">
            No hay productos para mostrar. Revisa que WordPress esté respondiendo.
        </p>
    ) : (
        <div class="destacados-swiper swiper" data-destacados data-total={productos.length}>
            <div class="swiper-wrapper">
                {productos.map((product) => (
                    <div class="swiper-slide h-auto">
                        <ProductCard product={product} />
                    </div>
                ))}
            </div>
        </div>
    )}
</section>

<style is:global>
    /* El movimiento continuo necesita avance lineal: con la curva por defecto
       el carrusel "salta" en cada transición en vez de deslizarse parejo. */
    .destacados-swiper .swiper-wrapper {
        transition-timing-function: linear;
    }
    /* Las tarjetas deben estirarse a la misma altura dentro del slide. */
    .destacados-swiper .swiper-slide {
        height: auto;
        display: flex;
    }
    .destacados-swiper .swiper-slide > article {
        width: 100%;
    }
</style>

<script>
    // Carrusel de avance continuo: en vez de saltar de a una tarjeta, se
    // desplaza lento y sin pausa (delay 0 + velocidad alta), como una cinta.
    // Se detiene al pasar el mouse para poder leer y hacer clic.
    import Swiper from 'swiper';
    import { Autoplay, FreeMode } from 'swiper/modules';

    let instancia: Swiper | null = null;

    function initDestacados() {
        instancia?.destroy(true, true);
        instancia = null;

        const el = document.querySelector<HTMLElement>('[data-destacados]');
        if (!el) return;

        const total = Number(el.dataset.total ?? '0');
        // El loop de Swiper necesita bastante más slides que los visibles; con
        // pocos productos se queda quieto en vez de dar saltos raros.
        if (total < 6) return;

        // Un carrusel que avanza solo, sin parar, es exactamente el tipo de
        // movimiento que molesta a quien activó "reducir movimiento" en su
        // sistema. Se deja quieto y arrastrable a mano, no se esconde.
        const menosMovimiento = matchMedia('(prefers-reduced-motion: reduce)').matches;

        instancia = new Swiper(el, {
            modules: [Autoplay, FreeMode],
            slidesPerView: 1.15,
            spaceBetween: 18,
            loop: true,
            speed: 5000,
            freeMode: { enabled: true, momentum: false },
            autoplay: menosMovimiento ? false : {
                delay: 0,
                disableOnInteraction: false,
                pauseOnMouseEnter: true,
            },
            breakpoints: {
                640: { slidesPerView: 2.2, spaceBetween: 18 },
                1024: { slidesPerView: 3.4, spaceBetween: 18 },
                1280: { slidesPerView: 4, spaceBetween: 18 },
            },
        });
    }

    document.addEventListener('astro:page-load', initDestacados);
</script>
