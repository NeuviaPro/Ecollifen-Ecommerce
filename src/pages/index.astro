---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/sections/Hero.astro';
import AccesosDestacados from '@/components/sections/AccesosDestacados.astro';
import CategoriasDestacadas from '@/components/sections/CategoriasDestacadas.astro';
import ServicioTecnico from '@/components/sections/ServicioTecnico.astro';
import DestacadosAgricultura from '@/components/sections/DestacadosAgricultura.astro';
import Asesoria from '@/components/sections/Asesoria.astro';
---

{/*
  Orden según el rediseño: el producto manda y la asesoría respalda.
  El hero abre el funnel; debajo, los accesos a Raíz Viva, Kits y Huertos;
  luego las categorías por rubro y la banda de
  servicio técnico (que se lee como garantía), y luego una fila de producto
  REAL con precio y stock. El cierre invita a la asesoría.
*/}
<Layout title="Inicio">
  <Hero />
  <AccesosDestacados />
  <CategoriasDestacadas />
  <ServicioTecnico />
  <DestacadosAgricultura />
  <Asesoria />
</Layout>