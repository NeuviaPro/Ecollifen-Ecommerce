---
// Modal de vista rápida de producto.
//
// Vive en el Layout, una sola vez para todo el sitio. Antes estaba dentro de
// Catalogo.astro, y por eso el botón "Vista rápida" que ProductCard dibuja en
// TODAS sus tarjetas solo funcionaba en /tienda: en la home y en la ficha de
// producto el botón existía pero el modal no estaba en la página.
//
// La regla que evita que vuelva a pasar: quien dibuja el botón es ProductCard,
// así que el modal tiene que estar donde pueda haber un ProductCard — es decir,
// en cualquier parte. De ahí que se monte desde el Layout y no desde una
// sección concreta.
//
// Se rellena en JS a partir de los data-* de la tarjeta sobre la que se hizo
// clic: sin pedir nada al servidor, y con el precio/stock ya corregidos por
// PreciosEnVivo si aplicó.
---

<div
    data-qv-overlay
    hidden
    class="fixed inset-0 z-90 flex items-center justify-center bg-green-950/60 p-6 backdrop-blur-[3px]"
>
    <div
        data-qv-panel
        role="dialog"
        aria-modal="true"
        aria-label="Vista rápida del producto"
        class="relative grid w-full max-w-3xl grid-cols-1 overflow-hidden rounded-2xl bg-surface shadow-2xl sm:grid-cols-2"
    >
        <div class="flex items-center justify-center border-b border-border bg-white p-6 sm:border-r sm:border-b-0">
            <img data-qv-img src="" alt="" class="max-h-80 max-w-full object-contain" />
        </div>
        <div class="p-7">
            <p class="font-mono text-[11px] tracking-[0.08em] text-muted">
                <span data-qv-cat></span> <span data-qv-sku></span>
            </p>
            <h3 data-qv-nombre class="mt-3 font-display text-2xl leading-tight font-semibold text-primary"></h3>
            <div class="mt-4 flex items-baseline gap-3.5">
                <p data-qv-precio class="text-[28px] leading-none font-bold tracking-tight text-green-700 tabular-nums"></p>
                <span data-qv-estado class="font-mono text-[11px] font-medium"></span>
            </div>
            <p data-qv-desc class="mt-4 text-sm leading-relaxed text-muted"></p>
            <div class="mt-6 flex gap-2.5">
                <button
                    type="button"
                    data-qv-agregar
                    class="flex-1 rounded-lg bg-cta py-3 text-center font-semibold text-cta-contrast transition-colors hover:bg-green-600"
                >Agregar</button>
                <a
                    data-qv-cotizar
                    href="/contacto"
                    class="flex-1 rounded-lg border-[1.5px] border-border py-3 text-center font-semibold text-green-700 transition-colors hover:bg-surface-alt"
                >Cotizar</a>
                <a data-qv-ficha href="#" class="flex items-center justify-center rounded-lg border-[1.5px] border-border px-4 font-semibold text-primary transition-colors hover:bg-surface-alt">
                    Ver ficha
                </a>
            </div>
        </div>
        <button
            type="button"
            data-qv-cerrar
            aria-label="Cerrar vista rápida"
            class="absolute top-3.5 right-3.5 flex size-9 items-center justify-center rounded-full border border-border bg-surface text-muted transition-colors hover:bg-surface-alt hover:text-primary"
        >
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
        </button>
    </div>
</div>

<script>
    // Un único listener delegado en document, en vez de uno por botón.
    //
    // Es lo que arregla el bug de raíz: antes se recorrían los [data-quickview]
    // existentes al inicializar el catálogo, así que cualquier tarjeta fuera de
    // esa página (o dibujada después) quedaba muerta. Con delegación no importa
    // cuántas tarjetas haya, dónde estén, ni cuándo aparezcan.
    import { aparecer, desaparecer } from '@/lib/animaciones';

    const ESTADOS: Record<string, { label: string, color: string }> = {
        instock: { label: 'En stock', color: 'var(--color-isotipo)' },
        onbackorder: { label: 'Bajo pedido', color: 'var(--color-gold-700)' },
        outofstock: { label: 'Sin stock', color: 'var(--color-muted)' },
    };

    function overlay() {
        return document.querySelector<HTMLElement>('[data-qv-overlay]');
    }

    function texto(sel: string, valor: string) {
        const el = document.querySelector(sel);
        if (el) el.textContent = valor;
    }

    function abrirQV(card: HTMLElement) {
        const capa = overlay();
        if (!capa) return;

        const d = card.dataset;

        // El precio y el estado se leen de lo que la tarjeta muestra AHORA
        // (PreciosEnVivo ya pudo haberlos corregido), no del data- original.
        const precioTexto = card.querySelector('[data-precio]')?.textContent?.trim() ?? '';
        const stockActual = card.querySelector('[data-btn-agregar]')?.hasAttribute('hidden')
            ? 'outofstock'
            : 'instock';
        const estado = ESTADOS[stockActual] ?? ESTADOS.outofstock;
        const enStock = stockActual === 'instock';

        texto('[data-qv-nombre]', d.name ?? '');
        texto('[data-qv-cat]', d.cat ?? '');
        texto('[data-qv-sku]', d.sku ? `· SKU ${d.sku}` : '');
        texto('[data-qv-precio]', precioTexto);
        texto('[data-qv-desc]', d.desc || 'Sin descripción disponible — pide más detalle por asesoría.');

        const estadoEl = document.querySelector<HTMLElement>('[data-qv-estado]');
        if (estadoEl) {
            estadoEl.textContent = `● ${estado.label}`;
            estadoEl.style.color = estado.color;
        }

        const img = document.querySelector<HTMLImageElement>('[data-qv-img]');
        if (img) {
            img.src = d.img ?? '';
            img.alt = d.name ?? '';
        }

        const agregar = document.querySelector<HTMLElement>('[data-qv-agregar]');
        const cotizar = document.querySelector<HTMLElement>('[data-qv-cotizar]');
        if (agregar) {
            agregar.toggleAttribute('hidden', !enStock);
            // Reutiliza el handler global del carrito: el modal no repite la
            // lógica de agregar, solo se identifica con el id correcto.
            if (d.id) agregar.setAttribute('data-add-to-cart', d.id);
        }
        cotizar?.toggleAttribute('hidden', enStock);

        const ficha = document.querySelector<HTMLAnchorElement>('[data-qv-ficha]');
        if (ficha && d.id) ficha.href = `/producto/${d.id}`;

        capa.removeAttribute('hidden');
        document.body.classList.add('overflow-hidden');
        aparecer(capa.querySelector('[data-qv-panel]'));
    }

    function cerrarQV() {
        const capa = overlay();
        if (!capa || capa.hasAttribute('hidden')) return;

        // Se oculta recién cuando termina la salida, si no desaparecería de
        // golpe y la animación no se vería.
        desaparecer(capa.querySelector('[data-qv-panel]'), {
            onComplete: () => {
                capa.setAttribute('hidden', '');
                document.body.classList.remove('overflow-hidden');
            },
        });
    }

    // Los tres listeners se registran UNA vez sobre document, no en cada
    // navegación: el ClientRouter reemplaza el <body>, pero document sobrevive.
    document.addEventListener('click', (e) => {
        const objetivo = e.target as HTMLElement;

        const boton = objetivo.closest('[data-quickview]');
        if (boton) {
            e.preventDefault();
            const card = boton.closest('article');
            if (card instanceof HTMLElement) abrirQV(card);
            return;
        }

        // Cerrar: con la X, o pinchando el fondo fuera del panel.
        if (objetivo.closest('[data-qv-cerrar]') || objetivo.matches('[data-qv-overlay]')) {
            cerrarQV();
        }
    });

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') cerrarQV();
    });

    // Si se navega con el modal abierto, el <body> se queda bloqueado.
    document.addEventListener('astro:before-swap', () => {
        document.body.classList.remove('overflow-hidden');
    });
</script>
