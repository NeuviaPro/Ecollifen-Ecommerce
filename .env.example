# Plantilla de variables de entorno. Copia este archivo como .env y rellena los
# valores. NUNCA pongas claves reales aquí: .env.example SÍ se versiona en git.

# === WordPress / WooCommerce (headless) ===
# URL base de la API REST, sin barra final. En producción WordPress vive en /wp.
#   Producción:  https://ecollifen.cl/wp/wp-json
#   Desarrollo:  https://ecollifen.local/wp-json
# IMPORTANTE: usa HTTPS. WooCommerce solo lee las claves REST sobre HTTPS;
# sobre HTTP plano las ignora y responde 401. En LocalWP: habilita SSL y "Trust".
WP_API_URL=https://ecollifen.cl/wp/wp-json

# Claves de WooCommerce REST API v3 (WooCommerce > Ajustes > Avanzado > REST API).
# Basta con permiso de LECTURA: solo se usan en tiempo de build / servidor.
# SECRETO: nunca se exponen al navegador ni se suben a git.
WOO_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOO_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Público (se expone al cliente, por eso el prefijo PUBLIC_) ===
# URL del propio WordPress para las llamadas del navegador a la Store API (carrito).
PUBLIC_WP_URL=https://ecollifen.cl/wp
# URL pública del sitio Astro.
PUBLIC_SITE_URL=https://ecollifen.cl
# Página de pago de WooCommerce (en español el slug es /finalizar-compra).
PUBLIC_CHECKOUT_URL=https://ecollifen.cl/wp/finalizar-compra

# Número de WhatsApp para el CTA de asesoría (formato internacional sin +, ej. 56912345678).
# Si se deja vacío, el CTA lleva al formulario de asesoría de la home (#asesoria).
PUBLIC_WHATSAPP=

# Correo que recibe las solicitudes del formulario de contacto (pendiente de
# confirmar: el manual de marca dice marca@ecollifen.cl y cPanel usa
# ecollifen.ltda@gmail.com).
PUBLIC_CONTACTO_EMAIL=marca@ecollifen.cl
