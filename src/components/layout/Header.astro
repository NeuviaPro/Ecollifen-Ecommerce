---
import { Picture } from "astro:assets";
import MainNav from "./MainNav.astro";
import Logo from '@/assets/ecollifenLogo.png';
import { navigation } from '@/lib/navigation';
import CartBadge from '@/components/cart/CartBadge';
import Buscador from '@/components/search/Buscador.astro';
import { asesoriaHref } from '@/lib/contacto';
import { getAllWooCategories, getCatalogoCompleto } from '@/lib/api';
import { areasDeTienda, conteosDeRama } from '@/lib/categorias';
import type { Area } from '@/lib/categorias';

// Nota: el inicio de sesión de clientes queda FUERA de este primer alcance,
// por eso el header no lo enlaza. La cuenta nativa de WooCommerce existe en
// /wp/mi-cuenta si más adelante se decide exponerla.

// Las áreas del dropdown de Tienda son las categorías RAÍZ de WooCommerce: el
// nombre y el slug salen de ahí, así que renombrar o crear un área en WP se
// refleja solo en el próximo build (antes eran una lista escrita a mano y se
// desincronizaron: "agricola" pasó a ser "huertos-y-agricolas" y el enlace
// quedó apuntando a una página inexistente).
// El Header se renderiza en TODAS las páginas (~120 en el build); las dos
// llamadas están memoizadas, así que en la práctica son una sola petición real.
let areas: Area[] = [];
try {
    const [categorias, productos] = await Promise.all([
        getAllWooCategories(),
        getCatalogoCompleto(),
    ]);
    areas = areasDeTienda(categorias, conteosDeRama(categorias, productos));
} catch (error) {
    console.error('[header] No se pudieron cargar las categorías:', error);
}
---

{/* Centinela del scroll. En cuanto sale de pantalla, el header ya está pegado
    arriba y pasa a modo compacto. Se usa un IntersectionObserver sobre este
    punto en vez de escuchar el scroll: el navegador avisa solo cuando cruza el
    borde, en lugar de ejecutar código en cada fotograma del desplazamiento.
    Mide 1px y lo compensa con un margen negativo, así no altera el layout. */}
<div data-tope-pagina aria-hidden="true" class="h-px -mb-px"></div>

{/* sticky y NO fixed: así el header sigue ocupando su sitio en el flujo y la
    página no da el salto de altura típico al fijar una cabecera.
    z-30 lo deja por encima del contenido pero por debajo de los drawers del
    carrito y de los filtros (z-40/z-50), que deben poder taparlo. */}
<header data-header class="sticky top-0 z-30 w-full">
    {/* Barra utilitaria: verde más oscuro que el nav (como el diseño).
        Al bajar se pliega — es lo primero que sobra cuando alguien ya está
        leyendo. El grid de 1fr a 0fr permite animar el plegado sin fijar una
        altura a mano. */}
    <div class="barra-utilitaria grid bg-green-950 text-green-50">
        <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 overflow-hidden px-6 py-2 text-xs">
            <p class="font-mono">
                Soluciones que echan raíces · Despacho a todo Chile
            </p>
            <div class="hidden items-center gap-4 sm:flex">
                <a href="/servicio-tecnico" class="transition-colors hover:text-white">Servicio técnico</a>
                <a href="/contacto" class="transition-colors hover:text-white">Cotiza con asesoría</a>
            </div>
        </div>
    </div>

    {/* Nav principal: fondo blanco con tipografía en Tierra (#7A3B1E), el mismo
        café de los botones de Raíz Viva. El borde inferior es el que separa el
        nav del contenido: sin el verde de antes, sin línea la barra se fundía
        con las secciones claras de abajo. */}
    {/* El fondo translúcido y el desenfoque van AQUÍ y no en el <header>:
        backdrop-filter convierte al elemento en contenedor de los hijos
        position:fixed, y el drawer del menú móvil vive dentro de este header.
        Puesto arriba, el drawer dejaría de referirse al viewport y quedaría
        mal colocado al abrirlo. */}
    <div class="nav-barra border-b border-header-border bg-header-bg text-header-fg">
        <div class="nav-interior mx-auto flex max-w-6xl items-center gap-6 px-6 py-3">
            <a href="/" class="flex shrink-0 items-center">
                <Picture
                    src={Logo}
                    formats={['avif', 'webp']}
                    alt="Ecollifén"
                    width={52}
                    height={52}
                    densities={[1, 2]}
                    class="nav-logo h-13 w-auto"
                />
            </a>

            <MainNav class="hidden lg:flex justify-around" areas={areas} />

            <div class="ml-auto flex items-center gap-1 sm:gap-2">
                {/* Buscador de escritorio; en móvil va dentro del drawer */}
                <Buscador class="hidden md:block" />

                {/* Carrito — abre el drawer */}
                <button type="button" data-cart-toggle aria-label="Abrir carrito" class="relative flex items-center gap-2 rounded-lg p-2.5 transition-colors hover:bg-header-hover-bg hover:text-header-fg-hover">
                    <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="9" cy="20" r="1.5"></circle>
                        <circle cx="18" cy="20" r="1.5"></circle>
                        <path d="M2 3h3l2.4 12.4a1 1 0 0 0 1 .8h9.3a1 1 0 0 0 1-.8L21 7H6"></path>
                    </svg>
                    <CartBadge client:load transition:persist />
                    <span class="hidden text-sm font-medium sm:inline">Carrito</span>
                </button>

                {/* Abrir menú móvil */}
                <button
                    type="button"
                    data-menu-open
                    aria-label="Abrir menú"
                    aria-controls="mobile-menu"
                    aria-expanded="false"
                    class="rounded-lg p-2.5 transition-colors hover:bg-header-hover-bg hover:text-header-fg-hover lg:hidden"
                >
                    <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                        <path d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                </button>
            </div>
        </div>
    </div>

    {/* ===== Menú móvil (drawer lateral) ===== */}
    <div id="mobile-menu" class="lg:hidden">
        {/* Fondo oscuro; al tocarlo cierra */}
        <div
            data-menu-overlay
            data-menu-close
            class="fixed inset-0 z-40 bg-black/50 opacity-0 pointer-events-none transition-opacity duration-200"
        ></div>

        {/* Panel deslizante */}
        <aside
            data-menu-panel
            class="fixed top-0 right-0 z-50 flex h-dvh w-80 max-w-[85vw] translate-x-full flex-col bg-primary text-primary-contrast shadow-xl transition-transform duration-200"
        >
            <div class="flex items-center justify-between border-b border-white/10 px-5 py-4">
                <span class="font-display text-lg font-semibold">Menú</span>
                <button
                    type="button"
                    data-menu-close
                    aria-label="Cerrar menú"
                    class="rounded-lg p-2 transition-colors hover:bg-white/10"
                >
                    <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                        <path d="M6 6l12 12M18 6 6 18"></path>
                    </svg>
                </button>
            </div>

            {/* Buscador móvil: hasta ahora el teléfono no tenía forma de buscar */}
            <div class="border-b border-white/10 p-4">
                <Buscador variante="panel" />
            </div>

            <nav class="flex flex-col p-2">
                {navigation.map((item) => (
                    item.name === 'Tienda' ? (
                        <details class="group">
                            {/* Sin <a> anidado a propósito: un link dentro de <summary> es
                                ambiguo entre "navegar" y "desplegar" según el navegador.
                                "Ver todo el catálogo" va como primer ítem de abajo. */}
                            <summary class="flex cursor-pointer list-none items-center justify-between rounded-lg px-3 py-3 text-base font-medium transition-colors hover:bg-white/10 [&::-webkit-details-marker]:hidden">
                                Tienda
                                <svg class="size-4 shrink-0 transition-transform group-open:rotate-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="m9 6 6 6-6 6" />
                                </svg>
                            </summary>

                            <div class="ml-3.5 flex flex-col gap-0.5 border-l border-white/15 pl-2.5">
                                <a href="/tienda" class="rounded-lg px-2.5 py-2.5 text-sm font-semibold transition-colors hover:bg-white/10">
                                    Ver todo el catálogo
                                </a>
                                {areas.length > 0 && (
                                    <p class="px-2.5 pt-2 pb-1 font-mono text-[10px] tracking-wide text-green-200/70 uppercase">Por área</p>
                                )}
                                {areas.map((area) => (
                                    <a
                                        href={`/tienda/${area.slug}`}
                                        class="flex items-center justify-between gap-2 rounded-lg px-2.5 py-2.5 text-sm transition-colors hover:bg-white/10"
                                    >
                                        {area.name}
                                        <span class="font-mono text-[10px] text-green-200/60">{area.count}</span>
                                    </a>
                                ))}
                            </div>
                        </details>
                    ) : (
                        <a
                            href={item.href}
                            class="rounded-lg px-3 py-3 text-base font-medium transition-colors hover:bg-white/10"
                        >{item.name}</a>
                    )
                ))}
            </nav>

            <div class="mt-auto flex flex-col gap-1 border-t border-white/10 p-2 text-sm text-green-100">
                <a href="/contacto" class="rounded-lg px-3 py-3 transition-colors hover:bg-white/10">Cotiza con asesoría</a>
                <a href={asesoriaHref()} class="rounded-lg px-3 py-3 transition-colors hover:bg-white/10">Escribir por WhatsApp</a>
            </div>
        </aside>
    </div>
</header>

<style>
    /* --- Modo compacto del header ------------------------------------------
       Arriba del todo se ve entero y sólido. Al bajar se encoge y deja
       entrever el contenido, para que estorbe menos mientras se lee.

       Todo se resuelve con una clase en el <header> (.es-compacto) que pone el
       JavaScript: las transiciones y el aspecto viven en CSS, que es lo que
       mejor sabe hacer cada uno.

       No hace falta tocar prefers-reduced-motion: la regla global de
       global.css ya anula estas transiciones para quien lo tenga activado. */

    /* La barra utilitaria se pliega. De 1fr a 0fr en vez de max-height: no hay
       que inventar una altura, y funciona aunque el texto pase a dos líneas. */
    .barra-utilitaria {
        grid-template-rows: 1fr;
        transition: grid-template-rows 0.32s ease;
    }

    [data-header].es-compacto .barra-utilitaria {
        grid-template-rows: 0fr;
    }

    .nav-barra {
        transition: background-color 0.32s ease, box-shadow 0.32s ease, backdrop-filter 0.32s ease;
    }

    /* Translúcido + desenfoque, no `opacity`.
       Bajarle la opacidad al elemento entero también apagaría el logo, el
       texto y los iconos, y el nav quedaría ilegible sobre cualquier fondo.
       Así el FONDO deja ver lo que pasa por debajo mientras el contenido sigue
       a plena opacidad; el desenfoque es lo que mantiene el contraste. */
    [data-header].es-compacto .nav-barra {
        background-color: color-mix(in srgb, var(--color-header-bg) 78%, transparent);
        -webkit-backdrop-filter: blur(12px) saturate(140%);
        backdrop-filter: blur(12px) saturate(140%);
        box-shadow: 0 10px 30px -18px rgba(18, 58, 30, 0.55);
    }

    /* Menos alto: el nav pierde algo de aire y el logo encoge con él. */
    .nav-interior {
        transition: padding-block 0.32s ease;
    }

    [data-header].es-compacto .nav-interior {
        padding-block: 0.45rem;
    }

    .nav-logo {
        transition: height 0.32s ease;
    }

    [data-header].es-compacto .nav-logo {
        height: 2.5rem;
    }
</style>

<script>
    // Drawer del menú móvil. Se re-vincula en cada navegación por el
    // ClientRouter (astro:page-load); las funciones consultan el DOM al vuelo.
    function els() {
        return {
            panel: document.querySelector('[data-menu-panel]'),
            overlay: document.querySelector('[data-menu-overlay]'),
            openBtn: document.querySelector('[data-menu-open]'),
        };
    }

    function openMenu() {
        const { panel, overlay, openBtn } = els();
        panel?.classList.remove('translate-x-full');
        overlay?.classList.remove('opacity-0', 'pointer-events-none');
        document.body.classList.add('overflow-hidden');
        openBtn?.setAttribute('aria-expanded', 'true');
    }

    function closeMenu() {
        const { panel, overlay, openBtn } = els();
        panel?.classList.add('translate-x-full');
        overlay?.classList.add('opacity-0', 'pointer-events-none');
        document.body.classList.remove('overflow-hidden');
        openBtn?.setAttribute('aria-expanded', 'false');
    }

    function bindMenu() {
        els().openBtn?.addEventListener('click', openMenu);
        document.querySelectorAll('[data-menu-close]').forEach((el) =>
            el.addEventListener('click', closeMenu)
        );
        // Cerrar al tocar cualquier enlace del panel.
        els().panel?.addEventListener('click', (e) => {
            if (e.target instanceof Element && e.target.closest('a')) closeMenu();
        });
    }

    // --- Header compacto al bajar -----------------------------------------
    // Se observa el centinela de 1px que va justo encima del header: mientras
    // se ve, estamos arriba del todo; en cuanto sale de pantalla, el header ya
    // está pegado y se compacta.
    //
    // Con IntersectionObserver y no con un listener de scroll: el navegador
    // avisa solo en el cruce, en vez de ejecutar código en cada fotograma del
    // desplazamiento.
    let observadorTope: IntersectionObserver | null = null;

    function vigilarScroll() {
        // El ClientRouter reemplaza el DOM en cada navegación: el observador
        // anterior apuntaría a un nodo que ya no existe.
        observadorTope?.disconnect();
        observadorTope = null;

        const header = document.querySelector('[data-header]');
        const tope = document.querySelector('[data-tope-pagina]');
        if (!header || !tope) return;

        observadorTope = new IntersectionObserver(([entrada]) => {
            header.classList.toggle('es-compacto', !entrada.isIntersecting);
        });

        observadorTope.observe(tope);
    }

    // Vincular tras cada carga/navegación; cerrar con Escape (una sola vez).
    document.addEventListener('astro:page-load', bindMenu);
    document.addEventListener('astro:page-load', vigilarScroll);
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeMenu();
    });
</script>
