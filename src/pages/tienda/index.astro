---
import Layout from '@/layouts/Layout.astro';
import Catalogo from '@/components/product/Catalogo.astro';
import { getAllWooCategories, getCatalogoCompleto } from '@/lib/api';
import type { WooCategory, WooProduct } from '@/lib/api';
import { conteosDeRama } from '@/lib/categorias';

// Catálogo completo. Las categorías (sidebar) salen reales de WooCommerce —
// incluidas las vacías, para que se puedan descubrir aunque aún no tengan
// stock — así que al crear una nueva categoría en WP aparece aquí sin tocar
// código. Con try/catch para degradar con gracia si Woo no responde.
let categorias: WooCategory[] = [];
let products: WooProduct[] = [];
try {
    [categorias, products] = await Promise.all([
        getAllWooCategories(),
        getCatalogoCompleto(),
    ]);
} catch (error) {
    console.error('[tienda] No se pudo cargar el catálogo:', error);
}

// Contadores del sidebar: por rama completa, no por asignación directa.
const conteos = conteosDeRama(categorias, products);
---

<Layout title="Tienda">
    <Catalogo
        title="Tienda"
        products={products}
        categorias={categorias}
        conteos={conteos}
        totalCatalogo={products.length}
    />
</Layout>
