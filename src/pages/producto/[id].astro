---
import Layout from '@/layouts/Layout.astro';
import { getAllWooProducts } from '@/lib/api';
import type { WooProduct } from '@/lib/api';

// Una página estática por producto de WooCommerce.
export async function getStaticPaths() {
    const products = await getAllWooProducts();
    return products.map((product) => ({
        params: { id: String(product.id) },
        props: { product },
    }));
}

const { product } = Astro.props as { product: WooProduct };

const money = new Intl.NumberFormat('es-CL', {
    style: 'currency',
    currency: 'CLP',
    maximumFractionDigits: 0,
});

const estados: Record<string, { label: string, color: string }> = {
    instock:     { label: 'En stock',    color: 'text-isotipo' },
    onbackorder: { label: 'Bajo pedido', color: 'text-gold-700' },
    outofstock:  { label: 'Sin stock',   color: 'text-muted' },
};
const estado = estados[product.stock_status] ?? estados.outofstock;
const enStock = product.stock_status === 'instock';
const categoria = product.categories?.[0];
const mainImage = product.images?.[0];

// Ficha técnica: se arma con los atributos visibles del producto en Woo, más
// peso y dimensiones si están cargados. Hoy ningún producto tiene atributos,
// así que el bloque simplemente no se muestra — nada de tablas vacías.
const especificaciones: { k: string, v: string }[] = [
    ...(product.attributes ?? [])
        .filter((a) => a.visible && a.options?.length)
        .map((a) => ({ k: a.name, v: a.options.join(', ') })),
];

if (product.weight) {
    especificaciones.push({ k: 'Peso', v: `${product.weight} kg` });
}

const d = product.dimensions;
if (d?.length && d?.width && d?.height) {
    especificaciones.push({ k: 'Dimensiones', v: `${d.length} × ${d.width} × ${d.height} cm` });
}

// Estilos base para el HTML que viene de WordPress (sin plugin de tipografía).
const contenidoWP = "leading-relaxed [&_p]:mb-3 [&_ul]:my-3 [&_ul]:list-disc [&_ul]:pl-5 [&_li]:mb-1 [&_strong]:font-semibold [&_a]:text-isotipo [&_a]:underline";

// Open Graph: para que un link de producto compartido por WhatsApp muestre su
// propia foto, nombre y precio en vez de la tarjeta genérica del sitio.
const descripcionOG = (product.short_description || product.description || '')
    .replace(/<[^>]*>/g, ' ')
    .replace(/&[a-z]+;|&#\d+;/gi, ' ')
    .replace(/\s+/g, ' ')
    .trim()
    .slice(0, 160) || `${money.format(Number(product.price))} · ${estado.label}. Cotiza con asesoría técnica en Ecollifén.`;
---

<Layout title={product.name} description={descripcionOG} image={mainImage?.src} type="product">
    <div class="mx-auto max-w-6xl px-6 py-10">
        <nav class="font-mono text-xs text-muted">
            <a href="/" class="hover:text-primary">Inicio</a> /
            <a href="/tienda" class="hover:text-primary">Tienda</a>
            {categoria && (
                <Fragment> / <a href={`/tienda/${categoria.slug}`} class="hover:text-primary">{categoria.name}</a></Fragment>
            )}
            / <span class="text-foreground">{product.name}</span>
        </nav>

        <div class="mt-6 grid gap-10 lg:grid-cols-2">
            {/* Galería */}
            <div>
                {/* Mismo criterio que las tarjetas: fondo blanco para que las
                    fotos de catálogo (90% con fondo blanco) no se vean pegadas. */}
                <div class="aspect-square overflow-hidden rounded-2xl border border-border bg-white p-4">
                    {mainImage ? (
                        <img data-main-image src={mainImage.src} alt={mainImage.alt || product.name} class="h-full w-full object-contain" />
                    ) : (
                        <div class="flex h-full items-center justify-center text-muted">Sin imagen</div>
                    )}
                </div>
                {product.images.length > 1 && (
                    <div class="mt-3 flex flex-wrap gap-3">
                        {product.images.map((img) => (
                            <button
                                type="button"
                                data-thumb={img.src}
                                class="size-16 overflow-hidden rounded-lg border border-border bg-white p-1 transition-colors hover:border-primary"
                            >
                                <img src={img.src} alt="" class="h-full w-full object-contain" loading="lazy" />
                            </button>
                        ))}
                    </div>
                )}
            </div>

            {/* Información. Los data-* los usa PreciosEnVivo para refrescar
                precio y stock contra la Store API al cargar la página. */}
            <div data-id={product.id} data-price={product.price} data-stock={product.stock_status}>
                {categoria && (
                    <a href={`/tienda/${categoria.slug}`} class="font-mono text-xs tracking-wide text-isotipo uppercase">
                        {categoria.name}
                    </a>
                )}
                <h1 class="mt-2 font-display text-3xl font-semibold text-balance text-primary md:text-4xl">
                    {product.name}
                </h1>

                <div class="mt-3 flex items-center gap-4 font-mono text-xs">
                    {product.sku && <span class="text-muted">SKU · {product.sku}</span>}
                    <span data-estado class:list={["flex items-center gap-1", estado.color]}>&#9679; {estado.label}</span>
                </div>

                <div class="mt-5 flex items-baseline gap-3">
                    <span data-precio class="text-3xl font-semibold text-green-700 tabular-nums">{money.format(Number(product.price))}</span>
                    {product.on_sale && product.regular_price && (
                        <span class="text-lg text-muted line-through">{money.format(Number(product.regular_price))}</span>
                    )}
                </div>

                {product.short_description && (
                    <div class:list={["mt-5 text-muted", contenidoWP]} set:html={product.short_description} />
                )}

                <div class="mt-7 flex flex-wrap gap-3">
                    <button
                        type="button"
                        data-add-to-cart={product.id}
                        data-btn-agregar
                        hidden={!enStock}
                        class="rounded-lg bg-cta px-7 py-3.5 font-semibold text-cta-contrast transition-colors hover:bg-green-600"
                    >
                        Agregar al carrito
                    </button>
                    <a
                        href="/contacto"
                        data-btn-cotizar
                        hidden={enStock}
                        class="inline-flex items-center rounded-lg bg-cta px-7 py-3.5 font-semibold text-cta-contrast transition-colors hover:bg-green-600"
                    >
                        Cotizar
                    </a>
                    <a
                        href="/contacto"
                        class="inline-flex items-center rounded-lg border-[1.5px] border-border px-7 py-3.5 font-semibold text-primary transition-colors hover:bg-surface-alt"
                    >
                        Solicitar asesoría técnica
                    </a>
                </div>

                {especificaciones.length > 0 && (
                    <div class="mt-9 rounded-2xl border border-border bg-surface p-6">
                        <h2 class="font-mono text-xs tracking-[0.16em] text-muted">FICHA TÉCNICA</h2>
                        <dl class="mt-4 divide-y divide-border">
                            {especificaciones.map((spec) => (
                                <div class="flex items-baseline justify-between gap-6 py-2.5">
                                    <dt class="text-sm text-muted">{spec.k}</dt>
                                    <dd class="text-right text-sm font-medium text-foreground tabular-nums">{spec.v}</dd>
                                </div>
                            ))}
                        </dl>
                    </div>
                )}
            </div>
        </div>

        {product.description && (
            <div class="mt-14 max-w-3xl">
                <h2 class="font-display text-2xl font-semibold text-primary">Descripción</h2>
                <div class:list={["mt-4 text-foreground", contenidoWP]} set:html={product.description} />
            </div>
        )}
    </div>
</Layout>

<script>
    // Galería: al tocar una miniatura, cambia la imagen principal.
    function initFicha() {
        const main = document.querySelector('[data-main-image]');
        if (!main) return;
        document.querySelectorAll('[data-thumb]').forEach((btn) => {
            btn.addEventListener('click', () => {
                const src = btn.getAttribute('data-thumb');
                if (src) (main as HTMLImageElement).src = src;
            });
        });
    }
    document.addEventListener('astro:page-load', initFicha);
</script>
